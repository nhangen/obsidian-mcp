{
  "name": "@nhangen/obsidian-mcp",
  "version": "0.2.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhangen/obsidian-mcp.git"
  },
  "homepage": "https://github.com/nhangen/obsidian-mcp#readme",
  "bugs": "https://github.com/nhangen/obsidian-mcp/issues",
  "description": "Obsidian MCP server over stdio and authenticated Streamable HTTP.",
  "keywords": [
    "obsidian",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "vault",
    "notes"
  ],
  "type": "module",
  "main": "dist/stdio.mjs",
  "files": [
    "dist/",
    "monitor.mjs",
    "contract.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "obsidian-mcp": "dist/stdio.mjs",
    "claude-obsidian-mcp": "dist/stdio.mjs",
    "claude-obsidian-mcp-http": "dist/http.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "release:bundle": "node scripts/release.mjs",
    "release:client": "npm run build && bash scripts/release-client.sh",
    "monitor": "node monitor.mjs",
    "start": "node dist/stdio.mjs",
    "start:http": "node dist/http.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.2"
  }
}
