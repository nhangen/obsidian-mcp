#!/usr/bin/env python3
"""Verified native capture for isolated Codex and attached Claude plugins."""

import argparse
from contextlib import ExitStack, contextmanager
import datetime
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import shlex
import signal
import stat
import subprocess
import sys
import tempfile

try:
    import tomllib
except ImportError:
    print("obsidian-mcp-native: Python 3.11 or newer is required", file=sys.stderr)
    raise SystemExit(64) from None


BUNDLE = Path(__file__).resolve().parent.parent
HEX = re.compile(r"[0-9a-f]{64}\Z")
HASH = re.compile(r"(?:[0-9a-f]{40}|[0-9a-f]{64})\Z")
LIMIT = 262144
# Two accepted JSON components may expand when Unicode is canonicalized.
RETENTION_LIMIT = 12 * LIMIT + 16384
MAX_PENDING = 16
CLAUDE_PRODUCER_TIMEOUT = 3.0
COMMIT_CONTEXT_TEMPLATE = (
    "<replace with the goal and implemented change>",
    "<replace with investigation findings and decisions>",
    "<replace with verification and remaining work>",
)
ACTIVE = "active.json"
OWNED = ("config.toml", "hooks.json", "AGENTS.md")
CLAUDE_TOOLS = {
    "mcp__obsidian-write__obsidian_keeper_save": "mcp__obsidian_write__obsidian_keeper_save",
    "mcp__obsidian-write__obsidian_daily_append": "mcp__obsidian_write__obsidian_daily_append",
}
CLAUDE_EVENTS = (
    "SessionStart",
    "UserPromptSubmit",
    "PreToolUse",
    "PostToolUse",
    "PostToolUseFailure",
    "Stop",
    "StopFailure",
)
MAX_DRAIN_SESSIONS = 256
ENVIRONMENT = (
    "PATH",
    "HOME",
    "USER",
    "OBSIDIAN_MCP_ALLOW_HTTP",
    "OBSIDIAN_MCP_ALLOW_TAILNET_HTTP",
    "OBSIDIAN_MCP_NPX",
    "OBSIDIAN_MCP_READ_ENDPOINT",
    "OBSIDIAN_MCP_WRITE_ENDPOINT",
    "OBSIDIAN_MCP_READ_CREDENTIAL_PROVIDER",
    "OBSIDIAN_MCP_WRITE_CREDENTIAL_PROVIDER",
    "OBSIDIAN_MCP_READ_TOKEN_ENV",
    "OBSIDIAN_MCP_WRITE_TOKEN_ENV",
    "OBSIDIAN_MCP_READ_TOKEN_FILE",
    "OBSIDIAN_MCP_WRITE_TOKEN_FILE",
    "OBSIDIAN_MCP_READ_KEYCHAIN_SERVICE",
    "OBSIDIAN_MCP_WRITE_KEYCHAIN_SERVICE",
    "OBSIDIAN_MCP_READ_KEYCHAIN_ACCOUNT",
    "OBSIDIAN_MCP_WRITE_KEYCHAIN_ACCOUNT",
)


class NativeError(Exception):
    pass


class ArgumentParser(argparse.ArgumentParser):
    def error(self, message):
        raise NativeError("CLI_INVALID")


def digest(value):
    return hashlib.sha256(value).hexdigest()


def encode(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def identifier(value):
    if (
        not isinstance(value, str)
        or not 1 <= len(value) <= 200
        or any(ord(c) < 32 for c in value)
    ):
        raise NativeError("EVENT_ID_INVALID")
    return value


def private_read(path, *, limit=LIMIT):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        item = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(item.st_mode)
            or item.st_uid != os.getuid()
            or item.st_nlink != 1
            or stat.S_IMODE(item.st_mode) != 0o600
        ):
            raise NativeError("PRIVATE_FILE_INVALID")
        value = stream.read(limit + 1)
    if len(value) > limit:
        raise NativeError("STATE_TOO_LARGE")
    return value


def atomic_write(path, value, *, limit=LIMIT):
    if len(value) > limit:
        raise NativeError("STATE_TOO_LARGE")
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=".capture-")
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(value)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def project_mode(profile):
    mode = profile.get("projectMode", "git")
    if not isinstance(mode, str) or mode not in ("git", "directory"):
        raise NativeError("PROJECT_MODE_INVALID")
    if mode == "directory" and profile.get("host") != "claude-plugin":
        raise NativeError("PROJECT_MODE_HOST_UNSUPPORTED")
    return mode


def capture_scope(profile):
    scope = profile.get("scope", "project")
    if scope not in ("project", "user") or (
        scope == "user" and profile.get("host") != "claude-plugin"
    ):
        raise NativeError("CAPTURE_SCOPE_INVALID")
    return scope


def require_git_profile(profile):
    if project_mode(profile) != "git":
        raise NativeError("DIRECTORY_SESSION_ONLY")


def project_root(project, mode="git"):
    if not isinstance(mode, str) or mode not in ("git", "directory"):
        raise NativeError("PROJECT_MODE_INVALID")
    if mode == "directory" and not Path(project).is_absolute():
        raise NativeError("PROJECT_ROOT_REQUIRED")
    root = Path(project).resolve(strict=True)
    if not root.is_dir() or (
        mode == "git" and git(root, "rev-parse", "--show-toplevel").strip() != str(root)
    ):
        raise NativeError("PROJECT_ROOT_REQUIRED")
    return root


def clean_project(project):
    root = project_root(project)
    for directory in (root, *root.parents):
        if any(
            (directory / p).exists()
            for p in (
                ".codex",
                ".claude",
                ".opencode",
                ".agents",
                "AGENTS.md",
                "CLAUDE.md",
            )
        ):
            raise NativeError("CLEAN_PROJECT_REQUIRED")
    return root


def git(root, *args, allow_failure=False):
    producer = runpy.run_path(str(BUNDLE / "bin/obsidian-mcp-commit-event"))
    result = subprocess.run(
        ["git", "-C", str(root), *args],
        capture_output=True,
        timeout=5,
        env=dict(producer["isolated_environment"](), GIT_OPTIONAL_LOCKS="0"),
    )
    if len(result.stdout) > LIMIT or len(result.stderr) > LIMIT:
        raise NativeError("GIT_OUTPUT_LIMIT")
    if result.returncode:
        if allow_failure:
            return ""
        raise NativeError("GIT_FAILED")
    return result.stdout.decode("utf-8")


def trusted_bundle(expected):
    installer = runpy.run_path(str(BUNDLE / "bin/obsidian-mcp-client-install"))
    try:
        if BUNDLE.parent.name == "releases" and HEX.fullmatch(BUNDLE.name):
            return installer["verify_installed_release"](
                BUNDLE.parent.parent, BUNDLE.name, expected
            )
        return installer["verify_source"](BUNDLE, expected)[0]
    except installer["InstallError"]:
        raise NativeError("BUNDLE_UNTRUSTED") from None


def relative_folder(value):
    if (
        not isinstance(value, str)
        or not value
        or len(value.encode()) > 1024
        or any(ord(c) < 32 or ord(c) == 127 for c in value)
        or "\\" in value
        or any(p in ("", ".", "..") for p in value.split("/"))
        or Path(value).is_absolute()
    ):
        raise NativeError("FOLDER_INVALID")
    return value


def attach_profile(args):
    if args.host != "claude-plugin":
        raise NativeError("ATTACH_HOST_REQUIRED")
    metadata = trusted_bundle(args.release_sha256)
    routes = None
    if args.commit_routes is not None:
        consumer = runpy.run_path(str(BUNDLE / "bin/obsidian-mcp-capture-commit"))
        try:
            routes = consumer["read_commit_routes"](args.commit_routes)
        except consumer["CaptureError"]:
            raise NativeError("COMMIT_ROUTES_INVALID") from None
    if args.scope == "user":
        if args.project is not None or args.project_mode is not None:
            raise NativeError("USER_PROJECT_ARGUMENTS_UNSUPPORTED")
        project = None
    else:
        mode = project_mode(
            dict(host=args.host, projectMode=args.project_mode or "git")
        )
        project = project_root(args.project, mode)
    folder = relative_folder(args.folder)
    daily = relative_folder(args.daily_folder)
    home = Path(args.home).absolute()
    if (
        home.exists()
        or home.is_symlink()
        or not home.parent.is_dir()
        or home.parent.resolve() != home.parent
    ):
        raise NativeError("NEW_PROFILE_REQUIRED")
    descriptor = dict(
        schemaVersion=1,
        host="claude-plugin",
        python=str(Path(sys.executable).resolve()),
        bundle=str(BUNDLE),
        releaseSha256=args.release_sha256,
        releaseId=metadata["releaseId"],
        folder=folder,
        dailyFolder=daily,
        files={},
        active=True,
    )
    if args.scope == "user":
        descriptor["scope"] = "user"
    else:
        descriptor.update(project=str(project), projectMode=mode)
    if routes is not None:
        descriptor["commitRoutes"] = routes
    home.mkdir(mode=0o700)
    (home / "capture-state").mkdir(mode=0o700)
    if args.scope == "user":
        (home / "workspaces").mkdir(mode=0o700)
        (home / "bindings").mkdir(mode=0o700)
    atomic_write(home / "capture-profile.json", encode(descriptor))
    return dict(
        status="attached",
        host="claude-plugin",
        home=str(home),
        project=str(project) if project is not None else None,
        scope=args.scope,
        release_id=metadata["releaseId"],
        ownership_changed=False,
    )


def capabilities(expected):
    metadata = trusted_bundle(expected)
    return dict(
        apiVersion=1,
        hosts=["codex", "claude-plugin"],
        projectModes={"claude-plugin": ["git", "directory"], "codex": ["git"]},
        captureScopes={"claude-plugin": ["project", "user"], "codex": ["project"]},
        release_id=metadata["releaseId"],
        operations=[
            "attach",
            "profile-status",
            "drain-status",
            "hook",
            "prepare",
            "retry",
            "request",
        ],
        claude_hook_events=list(CLAUDE_EVENTS),
        claude_write_tools=list(CLAUDE_TOOLS),
        prompt_identity="transcript-watermark-v1",
        ownership_managed=False,
    )


def create_profile(args):
    if args.scope != "project":
        raise NativeError("CAPTURE_SCOPE_INVALID")
    require_git_profile(dict(host="codex", projectMode=args.project_mode or "git"))
    metadata = trusted_bundle(args.release_sha256)
    project = clean_project(args.project)
    home = Path(args.home).absolute()
    if (
        home.exists()
        or home.is_symlink()
        or not home.parent.is_dir()
        or home.parent.resolve() != home.parent
    ):
        raise NativeError("NEW_PROFILE_REQUIRED")
    parts = Path(args.folder).parts
    if (
        not parts
        or Path(args.folder).is_absolute()
        or ".." in parts
        or any(ord(c) < 32 for c in args.folder)
        or args.folder.endswith("/")
    ):
        raise NativeError("FOLDER_INVALID")
    forwarded = list(ENVIRONMENT)
    for profile in ("READ", "WRITE"):
        name = os.environ.get(f"OBSIDIAN_MCP_{profile}_TOKEN_ENV")
        if name:
            if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
                raise NativeError("TOKEN_ENV_INVALID")
            forwarded.append(name)
    native = str(BUNDLE / "bin/obsidian-mcp-native")
    python = str(Path(sys.executable).resolve())
    hooks = {"hooks": {}}
    for event, matcher in (
        ("UserPromptSubmit", None),
        (
            "PreToolUse",
            "^(Bash|mcp__obsidian_write__obsidian_keeper_save|mcp__obsidian_write__obsidian_daily_append)$",
        ),
        (
            "PostToolUse",
            "^(Bash|mcp__obsidian_write__obsidian_keeper_save|mcp__obsidian_write__obsidian_daily_append)$",
        ),
        ("Stop", None),
    ):
        entry = {
            "hooks": [
                {
                    "type": "command",
                    "command": shlex.join(
                        [python, native, "hook", "--home", str(home)]
                    ),
                    "timeout": 15,
                }
            ]
        }
        if matcher:
            entry["matcher"] = matcher
        hooks["hooks"][event] = [entry]
    config = (
        'sandbox_mode = "workspace-write"\n'
        "[sandbox_workspace_write]\nwritable_roots = "
        + json.dumps([str(home / "capture-state")])
        + "\n[features]\nhooks = true\n"
    )
    for name, launcher in (
        ("obsidian", "obsidian-mcp-read"),
        ("obsidian-write", "obsidian-mcp-write"),
    ):
        config += (
            f"\n[mcp_servers.{name}]\ncommand = {json.dumps(str(BUNDLE / 'bin' / launcher))}\n"
            'startup_timeout_sec = 30\ntool_timeout_sec = 120\ndefault_tools_approval_mode = "auto"\n'
            f"env_vars = {json.dumps(forwarded)}\n"
        )
    policy = (BUNDLE / "hosts/codex-capture.md").read_bytes()
    files = {
        "config.toml": config.encode(),
        "hooks.json": encode(hooks),
        "AGENTS.md": policy,
    }
    descriptor = dict(
        schemaVersion=1,
        host="codex",
        python=python,
        bundle=str(BUNDLE),
        releaseSha256=args.release_sha256,
        releaseId=metadata["releaseId"],
        project=str(project),
        folder=args.folder,
        files={name: digest(body) for name, body in files.items()},
        config=tomllib.loads(config),
        active=True,
    )
    home.mkdir(mode=0o700)
    for name, body in files.items():
        atomic_write(home / name, body)
    (home / "capture-state").mkdir(mode=0o700)
    (home / "runtime-home").mkdir(mode=0o700)
    atomic_write(home / "capture-profile.json", encode(descriptor))
    return dict(
        status="created",
        home=str(home),
        writer="mcp",
        scope="isolated-profile",
        launch_command=shlex.join([python, native, "run", "--home", str(home)]),
        release_id=metadata["releaseId"],
    )


def load_profile(home, *, parent_only=False, inspect=False):
    home = Path(home).absolute()
    item = home.lstat()
    if (
        not stat.S_ISDIR(item.st_mode)
        or home.is_symlink()
        or item.st_uid != os.getuid()
        or stat.S_IMODE(item.st_mode) != 0o700
        or home.resolve() != home
    ):
        raise NativeError("PROFILE_INVALID")
    profile = json.loads(private_read(home / "capture-profile.json"))
    if (
        not isinstance(profile, dict)
        or profile.get("schemaVersion") != 1
        or profile.get("active") is not True
        or profile.get("host") not in ("codex", "claude-plugin")
        or profile.get("bundle") != str(BUNDLE)
        or (profile.get("files") != {} and profile.get("host") == "claude-plugin")
        or (
            profile.get("host") == "codex"
            and set(profile.get("files", {})) != set(OWNED)
        )
    ):
        raise NativeError("PROFILE_INACTIVE_OR_INVALID")
    scope = capture_scope(profile)
    commit_routes(profile)
    if parent_only and (scope != "user" or "parentHome" in profile):
        raise NativeError("CHILD_PARENT_INVALID")
    mode = project_mode(profile) if scope == "project" else None
    python = Path(profile.get("python", ""))
    if (
        not python.is_absolute()
        or not python.is_file()
        or not os.access(python, os.X_OK)
    ):
        raise NativeError(
            "PROFILE_PYTHON_UNAVAILABLE; recreate profile with Python 3.11 or newer"
        )
    if profile["host"] == "claude-plugin":
        relative_folder(profile["folder"])
        relative_folder(profile["dailyFolder"])
        if scope == "user":
            if (
                profile.get("project") is not None
                or "projectMode" in profile
                or "parentHome" in profile
            ):
                raise NativeError("USER_PROFILE_INVALID")
            private_directory(home / "workspaces")
            private_directory(home / "bindings")
        else:
            project = profile.get("project")
            if (
                not isinstance(project, str)
                or not Path(project).is_absolute()
                or os.path.normpath(project) != project
            ):
                raise NativeError("PROFILE_PROJECT_INVALID")
            if not inspect and str(project_root(project, mode)) != project:
                raise NativeError("PROFILE_PROJECT_INVALID")
            if inspect:
                try:
                    present = Path(project).resolve(strict=True)
                except FileNotFoundError:
                    present = None
                if present is not None and (
                    str(present) != project or not present.is_dir()
                ):
                    raise NativeError("PROFILE_PROJECT_INVALID")
        parent_home = profile.get("parentHome")
        if parent_home is None and home.parent.name == "workspaces":
            try:
                hint = json.loads(
                    private_read(home.parent.parent / "capture-profile.json")
                )
            except FileNotFoundError:
                hint = {}
            if isinstance(hint, dict) and hint.get("scope") == "user":
                parent_home = str(home.parent.parent)
        if parent_home is not None:
            parent, owner = load_profile(parent_home, parent_only=True, inspect=inspect)
            validate_child(parent, owner, home, profile)
        metadata = trusted_bundle(profile["releaseSha256"])
        if metadata["releaseId"] != profile.get("releaseId"):
            raise NativeError("PROFILE_RELEASE_INVALID")
        checked_state_directory(home)
        return home, profile
    for name in OWNED:
        body = private_read(home / name)
        if name == "config.toml":
            config = tomllib.loads(body.decode())
            for host_key in ("tui", "projects"):
                config.pop(host_key, None)
            host_hooks = config.pop("hooks", {})
            if not isinstance(host_hooks, dict) or set(host_hooks) - {"state"}:
                raise NativeError("PROFILE_DRIFT")
            if config != profile.get("config"):
                raise NativeError("PROFILE_DRIFT")
        elif digest(body) != profile["files"][name]:
            raise NativeError("PROFILE_DRIFT")
    trusted_bundle(profile["releaseSha256"])
    clean_project(profile["project"])
    return home, profile


def private_directory(path):
    item = path.lstat()
    if (
        not stat.S_ISDIR(item.st_mode)
        or path.resolve() != path
        or item.st_uid != os.getuid()
        or stat.S_IMODE(item.st_mode) != 0o700
    ):
        raise NativeError("PRIVATE_DIRECTORY_INVALID")
    return path


def workspace_key(project, mode):
    return digest(encode([project, mode]))


def child_profile(home, profile, project, mode):
    return dict(
        {k: v for k, v in profile.items() if k != "scope"},
        project=project,
        projectMode=mode,
        parentHome=str(home),
    )


def validate_child(parent, owner, home, profile):
    project = profile.get("project")
    mode = project_mode(profile)
    key = workspace_key(project, mode)
    private_directory(parent / "workspaces")
    if home != parent / "workspaces" / key or profile != child_profile(
        parent, owner, project, mode
    ):
        raise NativeError("CHILD_PROFILE_INVALID")


def read_hot_binding(home, session):
    if not isinstance(session, str) or HEX.fullmatch(session) is None:
        raise NativeError("SESSION_KEY_INVALID")
    directory = private_directory(home / "bindings")
    path = directory / (session + ".json")
    try:
        record = json.loads(private_read(path))
    except FileNotFoundError:
        if path.is_symlink():
            raise NativeError("SESSION_BINDING_INVALID") from None
        return None, path
    validate_binding(record, session)
    return record, path


def validate_binding(record, session):
    if (
        not isinstance(record, dict)
        or set(record) - {"archiveGeneration"}
        != {
            "schemaVersion",
            "session",
            "workspace",
            "project",
            "projectMode",
            "paused",
            "enrolled",
        }
        or record.get("schemaVersion") != 1
        or record.get("session") != session
        or record.get("projectMode") not in ("git", "directory")
        or not isinstance(record.get("project"), str)
        or not Path(record["project"]).is_absolute()
        or type(record.get("paused")) is not bool
        or type(record.get("enrolled")) is not bool
        or (
            "archiveGeneration" in record
            and (
                not isinstance(record["archiveGeneration"], str)
                or HEX.fullmatch(record["archiveGeneration"]) is None
            )
        )
        or record.get("workspace")
        != workspace_key(record["project"], record["projectMode"])
    ):
        raise NativeError("SESSION_BINDING_INVALID")


def streamed_entries(directory):
    private_directory(directory)
    with os.scandir(directory) as scan:
        for entry in scan:
            yield Path(entry.path)


def sync_directory(directory):
    fd = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def archive_index(home, session):
    directory = home / "archive" / session
    if not directory.exists() and not directory.is_symlink():
        locator = home / "retained-bindings" / (session + ".json")
        if locator.exists() or locator.is_symlink():
            raise NativeError("RETENTION_ARCHIVE_MISSING")
        return None
    private_directory(home / "archive")
    private_directory(directory)
    index = json.loads(private_read(directory / "index.json", limit=RETENTION_LIMIT))
    if (
        not isinstance(index, dict)
        or set(index) != {"generation", "location"}
        or index.get("location") not in ("hot", "archive")
        or not isinstance(index.get("generation"), str)
        or HEX.fullmatch(index["generation"]) is None
    ):
        raise NativeError("RETENTION_INDEX_INVALID")
    return index


def validate_archive(value, session, generation):
    if (
        not isinstance(value, dict)
        or set(value) != {"schemaVersion", "binding", "state", "generation"}
        or value.get("schemaVersion") != 1
    ):
        raise NativeError("RETENTION_ARCHIVE_INVALID")
    binding, state = value["binding"], value["state"]
    validate_binding(binding, session)
    if (
        value.get("generation") != generation
        or digest(encode([binding, state])) != generation
        or not isinstance(binding, dict)
        or binding.get("session") != session
        or binding.get("workspace")
        != workspace_key(binding.get("project"), binding.get("projectMode"))
    ):
        raise NativeError("RETENTION_ARCHIVE_INVALID")
    if state is None:
        if binding.get("enrolled") is not False:
            raise NativeError("RETENTION_ARCHIVE_INVALID")
    elif (
        not isinstance(state, dict)
        or state.get("schemaVersion") != 1
        or state.get("session") != session
        or drain_reasons(state)
    ):
        raise NativeError("RETENTION_ARCHIVE_INVALID")
    return value


def archived_record(home, session, index):
    generation = index["generation"]
    directory = home / "archive" / session

    def read_generation(key):
        value = validate_archive(
            json.loads(
                private_read(directory / (key + ".json"), limit=RETENTION_LIMIT)
            ),
            session,
            key,
        )
        return value

    current = value = read_generation(generation)
    checkpoint, distance, power = generation, 0, 1
    while predecessor := value["binding"].get("archiveGeneration"):
        if predecessor == checkpoint:
            raise NativeError("RETENTION_LINEAGE_INVALID")
        value = read_generation(predecessor)
        if any(
            value["binding"][key] != current["binding"][key]
            for key in ("session", "workspace", "project", "projectMode")
        ):
            raise NativeError("RETENTION_LINEAGE_INVALID")
        distance += 1
        if distance == power:
            checkpoint, distance, power = predecessor, 0, power * 2
    retained_locator(home, session, current, first_generation=value["generation"])
    return current


def retained_locator(home, session, envelope, *, create=False, first_generation=None):
    directory = home / "retained-bindings"
    if create:
        directory.mkdir(mode=0o700, exist_ok=True)
    private_directory(directory)
    path = directory / (session + ".json")
    try:
        value = json.loads(private_read(path))
    except FileNotFoundError:
        if not create or path.is_symlink():
            raise NativeError("RETENTION_BINDING_MISSING") from None
        value = dict(
            session=session,
            workspace=envelope["binding"]["workspace"],
            firstGeneration=envelope["generation"],
        )
        atomic_write(path, encode(value))
    if (
        not isinstance(value, dict)
        or set(value) != {"session", "workspace", "firstGeneration"}
        or value.get("session") != session
        or value.get("workspace") != envelope["binding"]["workspace"]
        or not isinstance(value.get("firstGeneration"), str)
        or HEX.fullmatch(value["firstGeneration"]) is None
        or (
            first_generation is not None
            and value["firstGeneration"] != first_generation
        )
    ):
        raise NativeError("RETENTION_BINDING_INVALID")
    first = home / "archive" / session / (value["firstGeneration"] + ".json")
    first_record = validate_archive(
        json.loads(private_read(first, limit=RETENTION_LIMIT)),
        session,
        value["firstGeneration"],
    )
    if "archiveGeneration" in first_record["binding"]:
        raise NativeError("RETENTION_LINEAGE_INVALID")


def read_binding(home, session, *, restore=True):
    hot, path = read_hot_binding(home, session)
    index = archive_index(home, session)
    if index is None:
        if hot and "archiveGeneration" in hot:
            raise NativeError("RETENTION_CONFLICT")
        return hot, path
    archived = archived_record(home, session, index)
    retained_locator(home, session, archived)
    if index["location"] == "hot":
        if (
            hot is None
            or hot.get("archiveGeneration") != index["generation"]
            or any(
                hot.get(k) != archived["binding"].get(k)
                for k in (
                    "schemaVersion",
                    "session",
                    "workspace",
                    "project",
                    "projectMode",
                )
            )
        ):
            raise NativeError("RETENTION_CONFLICT")
        return hot, path
    if hot is not None:
        raise NativeError("RETENTION_CONFLICT")
    if restore:
        transition_retention(home, "restore", archived, index)
        return read_hot_binding(home, session)
    return archived["binding"], path


def clean_retention_temporaries(expected):
    for directory, bodies in expected.items():
        for entry in streamed_entries(directory):
            if not entry.name.startswith(".capture-"):
                continue
            if private_read(entry, limit=RETENTION_LIMIT) not in bodies:
                raise NativeError("RETENTION_TEMPORARY_AMBIGUOUS")
            entry.unlink()
        sync_directory(directory)


def validate_retention_journal(home, value, *, unpublished=False):
    if (
        not isinstance(value, dict)
        or set(value) != {"schemaVersion", "operation", "record", "before"}
        or value.get("schemaVersion") != 1
        or value.get("operation") not in ("archive", "restore")
    ):
        raise NativeError("RETENTION_JOURNAL_INVALID")
    envelope = value["record"]
    session = (
        envelope.get("binding", {}).get("session")
        if isinstance(envelope, dict) and isinstance(envelope.get("binding"), dict)
        else None
    )
    if not isinstance(session, str) or HEX.fullmatch(session) is None:
        raise NativeError("RETENTION_JOURNAL_INVALID")
    envelope = validate_archive(envelope, session, envelope.get("generation"))
    before = value["before"]
    if before is not None and (
        not isinstance(before, dict)
        or set(before) != {"generation", "location"}
        or before.get("location") not in ("hot", "archive")
        or not isinstance(before.get("generation"), str)
        or HEX.fullmatch(before["generation"]) is None
    ):
        raise NativeError("RETENTION_JOURNAL_INVALID")
    binding = envelope["binding"]
    child = home / "workspaces" / binding["workspace"]
    _, descriptor = load_profile(child, inspect=True)
    _, parent = load_profile(home, inspect=True)
    validate_child(home, parent, child, descriptor)
    archive = home / "archive"
    if archive.exists() or archive.is_symlink():
        private_directory(archive)
    directory = archive / session
    generation = envelope["generation"]
    target = directory / (generation + ".json")
    try:
        index = archive_index(home, session)
    except FileNotFoundError:
        if value["before"] is not None:
            raise NativeError("RETENTION_CONFLICT") from None
        index = None
    after = dict(
        generation=generation,
        location="archive" if value["operation"] == "archive" else "hot",
    )
    if index != value["before"] and index != after:
        raise NativeError("RETENTION_CONFLICT")
    if unpublished and index != before:
        raise NativeError("RETENTION_CONFLICT")
    if value["operation"] == "restore":
        if before != dict(generation=generation, location="archive"):
            raise NativeError("RETENTION_JOURNAL_INVALID")
    elif before is None:
        if "archiveGeneration" in binding:
            raise NativeError("RETENTION_LINEAGE_INVALID")
    elif before["location"] != "hot":
        raise NativeError("RETENTION_JOURNAL_INVALID")
    if before is not None:
        archived_record(home, session, before)
        if (
            value["operation"] == "archive"
            and binding.get("archiveGeneration") != before["generation"]
        ):
            raise NativeError("RETENTION_LINEAGE_INVALID")
    with state_lock(child, session, create=False) as (state, _):
        hot, _ = read_hot_binding(home, session)
        if value["operation"] == "archive":
            if (active_request(child) or {}).get("session") == session or (
                (hot is not None and hot != binding)
                or (state is not None and state != envelope["state"])
                or (
                    index != after
                    and (hot is None or (binding["enrolled"] and state is None))
                )
            ):
                raise NativeError("RETENTION_CONFLICT")
        elif (
            (hot is not None and hot != dict(binding, archiveGeneration=generation))
            or (state is not None and state != envelope["state"])
            or (
                index == after
                and (hot is None or (binding["enrolled"] and state is None))
            )
            or (unpublished and (hot is not None or state is not None))
        ):
            raise NativeError("RETENTION_CONFLICT")
        if target.exists() or target.is_symlink() or value["operation"] == "restore":
            if private_read(target, limit=RETENTION_LIMIT) != encode(envelope):
                raise NativeError("RETENTION_CONFLICT")
    return envelope, before, child, directory, index, after


def publication_candidates(directory, *, limit=LIMIT):
    for entry in streamed_entries(directory):
        if entry.name.startswith(".capture-"):
            body = private_read(entry, limit=limit)
            value = json.loads(body)
            if not isinstance(value, dict) or encode(value) != body:
                raise NativeError("PUBLICATION_AMBIGUOUS")
            yield entry, body, value


def select_publication(directory, selector, *, limit=LIMIT):
    selected = None
    for candidate in publication_candidates(directory, limit=limit):
        if selector(candidate[2]):
            if selected is not None and selected[1] != candidate[1]:
                raise NativeError("PUBLICATION_AMBIGUOUS")
            selected = candidate
    return selected


def publish_candidate(candidate, target, *, limit=LIMIT, before=None):
    entry, body, _ = candidate
    if private_read(entry, limit=limit) != body:
        raise NativeError("PUBLICATION_AMBIGUOUS")
    if target.exists() or target.is_symlink():
        existing = private_read(target, limit=limit)
        if existing == body:
            entry.unlink()
        elif before is not None and existing == before:
            os.replace(entry, target)
        else:
            raise NativeError("PUBLICATION_CONFLICT")
    else:
        os.replace(entry, target)
    sync_directory(target.parent)


def reconcile_retention(home):
    journal = home / "retention-journal.json"
    try:
        value = json.loads(private_read(journal, limit=RETENTION_LIMIT))
    except FileNotFoundError:
        if journal.is_symlink():
            raise NativeError("RETENTION_JOURNAL_INVALID") from None
        candidate = select_publication(home, lambda value: True, limit=RETENTION_LIMIT)
        if candidate is None:
            return
        validate_retention_journal(home, candidate[2], unpublished=True)
        publish_candidate(candidate, journal, limit=RETENTION_LIMIT)
        value = candidate[2]
    envelope, before, child, directory, index, after = validate_retention_journal(
        home, value
    )
    for _, body, _ in publication_candidates(home, limit=RETENTION_LIMIT):
        if body != encode(value):
            raise NativeError("RETENTION_TEMPORARY_AMBIGUOUS")
    binding = envelope["binding"]
    session, generation = binding["session"], envelope["generation"]
    archive = home / "archive"
    archive.mkdir(mode=0o700, exist_ok=True)
    private_directory(archive)
    directory.mkdir(mode=0o700, exist_ok=True)
    private_directory(directory)
    target = directory / (generation + ".json")
    binding_path = home / "bindings" / (session + ".json")
    state_path = child / "capture-state" / (session + ".json")
    with state_lock(child, session) as (state, _):
        hot, _ = read_hot_binding(home, session)
        if value["operation"] == "archive":
            if (active_request(child) or {}).get("session") == session:
                raise NativeError("RETENTION_CONFLICT")
            if (
                (hot is not None and hot != binding)
                or (state is not None and state != envelope["state"])
                or (
                    index != after
                    and (hot is None or (binding["enrolled"] and state is None))
                )
            ):
                raise NativeError("RETENTION_CONFLICT")
            if target.exists() or target.is_symlink():
                if private_read(target, limit=RETENTION_LIMIT) != encode(envelope):
                    raise NativeError("RETENTION_CONFLICT")
            else:
                if hot is None:
                    raise NativeError("RETENTION_CONFLICT")
                atomic_write(target, encode(envelope), limit=RETENTION_LIMIT)
            retained_locator(home, session, envelope, create=before is None)
            atomic_write(directory / "index.json", encode(after), limit=RETENTION_LIMIT)
            sync_directory(archive)
            sync_directory(home)
            binding_path.unlink(missing_ok=True)
            state_path.unlink(missing_ok=True)
            sync_directory(binding_path.parent)
            sync_directory(state_path.parent)
        else:
            retained_locator(home, session, envelope)
            if private_read(target, limit=RETENTION_LIMIT) != encode(envelope):
                raise NativeError("RETENTION_CONFLICT")
            restored = dict(binding, archiveGeneration=generation)
            if (
                (hot is not None and hot != restored)
                or (state is not None and state != envelope["state"])
                or (
                    index == after
                    and (hot is None or (binding["enrolled"] and state is None))
                )
            ):
                raise NativeError("RETENTION_CONFLICT")
            if envelope["state"] is not None:
                atomic_write(state_path, encode(envelope["state"]))
            atomic_write(binding_path, encode(restored))
            atomic_write(directory / "index.json", encode(after), limit=RETENTION_LIMIT)
        expected = {home: (encode(value),), directory: (encode(after),)}
        if value["operation"] == "archive":
            expected[directory] += (encode(envelope),)
            locator = home / "retained-bindings"
            expected[locator] = (private_read(locator / (session + ".json")),)
        else:
            expected[binding_path.parent] = (encode(restored),)
            if envelope["state"] is not None:
                expected[state_path.parent] = (encode(envelope["state"]),)
        clean_retention_temporaries(expected)
    journal.unlink()
    sync_directory(home)


def transition_retention(home, operation, record, before):
    reconcile_retention(home)
    if (home / "retention-journal.json").exists() or (
        home / "retention-journal.json"
    ).is_symlink():
        raise NativeError("RETENTION_JOURNAL_PENDING")
    value = dict(schemaVersion=1, operation=operation, record=record, before=before)
    validate_retention_journal(home, value, unpublished=True)
    atomic_write(
        home / "retention-journal.json",
        encode(value),
        limit=RETENTION_LIMIT,
    )
    reconcile_retention(home)


def retire_terminal_sessions(home, profile):
    active = 0
    for entry in streamed_entries(home / "bindings"):
        if entry.suffix != ".json" or HEX.fullmatch(entry.stem) is None:
            raise NativeError("SESSION_BINDING_INVALID")
        binding, _ = read_binding(home, entry.stem, restore=False)
        child, _ = bound_child(home, profile, binding, inspect=True)
        if any(
            p.name.startswith(".capture-")
            for p in streamed_entries(checked_state_directory(child))
        ):
            active += 1
            continue
        try:
            with state_lock(child, entry.stem) as (state, _):
                if (state is not None and drain_reasons(state)) or (
                    active_request(child) or {}
                ).get("session") == entry.stem:
                    active += 1
                    continue
                if binding["enrolled"] and state is None:
                    raise NativeError("RETENTION_CONFLICT")
                generation = digest(encode([binding, state]))
                record = dict(
                    schemaVersion=1, binding=binding, state=state, generation=generation
                )
        except BlockingIOError:
            active += 1
            continue
        transition_retention(home, "archive", record, archive_index(home, entry.stem))
    return active


def bound_child(home, profile, record, *, inspect=False):
    private_directory(home / "workspaces")
    child = home / "workspaces" / record["workspace"]
    child, descriptor = load_profile(child, inspect=inspect)
    validate_child(home, profile, child, descriptor)
    if descriptor != child_profile(
        home, profile, record["project"], record["projectMode"]
    ):
        raise NativeError("SESSION_BINDING_INVALID")
    if record["enrolled"]:
        index = archive_index(home, record["session"]) if inspect else None
        if index is not None and index["location"] == "archive":
            if archived_record(home, record["session"], index)["binding"] != record:
                raise NativeError("RETENTION_CONFLICT")
        else:
            private_read(child / "capture-state" / (record["session"] + ".json"))
    return child, descriptor


def event_workspace(event):
    cwd = event.get("cwd")
    if not isinstance(cwd, str) or not cwd or not Path(cwd).is_absolute():
        raise NativeError("PROJECT_ROOT_REQUIRED")
    directory = Path(cwd).resolve(strict=True)
    if not directory.is_dir():
        raise NativeError("PROJECT_ROOT_REQUIRED")
    try:
        root = git(
            directory, "rev-parse", "--show-toplevel", allow_failure=True
        ).strip()
    except FileNotFoundError:
        root = ""
    return (
        (str(Path(root).resolve(strict=True)), "git")
        if root
        else (str(directory), "directory")
    )


def user_hook_failure(event, code):
    name = event.get("hook_event_name")
    message = (
        "Obsidian capture advisory: "
        + code
        + "; pending state retained, no new capture."
    )
    if name == "PreToolUse" and event.get("tool_name") in (
        *CLAUDE_TOOLS,
        *CLAUDE_TOOLS.values(),
    ):
        return {
            "hookSpecificOutput": dict(
                hookEventName=name,
                permissionDecision="deny",
                permissionDecisionReason=message,
            )
        }
    return context(name, message)


def check_user_state(home):
    if any(p.name != "active.lock" for p in checked_state_directory(home).iterdir()):
        raise NativeError("USER_STATE_INVALID")


def provision_child(home, profile, project, mode):
    key = workspace_key(project, mode)
    children = private_directory(home / "workspaces")
    child = children / key
    staging = home / "provisioning"
    staging.mkdir(mode=0o700, exist_ok=True)
    private_directory(staging)
    stage = staging / key
    expected = child_profile(home, profile, project, mode)
    if child.exists() or child.is_symlink():
        private_directory(child)
        if (child / "capture-profile.json").exists():
            loaded, descriptor = load_profile(child)
            validate_child(home, profile, loaded, descriptor)
            return child
        if (
            stage.exists()
            or {p.name for p in child.iterdir()} != {"capture-state"}
            or any(checked_state_directory(child).iterdir())
        ):
            raise NativeError("CHILD_PROVISIONING_AMBIGUOUS")
        os.rename(child, stage)
    stage.mkdir(mode=0o700, exist_ok=True)
    private_directory(stage)
    (stage / "capture-state").mkdir(mode=0o700, exist_ok=True)
    checked_state_directory(stage)
    if any((stage / "capture-state").iterdir()) or any(
        p.name not in ("capture-state", "capture-profile.json")
        and not p.name.startswith(".capture-")
        for p in stage.iterdir()
    ):
        raise NativeError("CHILD_PROVISIONING_AMBIGUOUS")
    descriptor = stage / "capture-profile.json"
    candidate = select_publication(stage, lambda value: True)
    if candidate is not None:
        if candidate[1] != encode(expected):
            raise NativeError("CHILD_PROVISIONING_AMBIGUOUS")
        publish_candidate(candidate, descriptor)
        clean_retention_temporaries({stage: (encode(expected),)})
    if descriptor.exists() or descriptor.is_symlink():
        if json.loads(private_read(descriptor)) != expected:
            raise NativeError("CHILD_PROFILE_INVALID")
    else:
        atomic_write(descriptor, encode(expected))
    os.rename(stage, child)
    for directory in (staging, children):
        fd = os.open(directory, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    return child


def initial_session_state(profile, session, turn, transcript=None, *, date=None):
    state = dict(
        schemaVersion=1,
        python=profile["python"],
        session=session,
        turn=turn,
        disposition="pending",
        session_save=session_plan(profile, session, turn, date=date),
        snapshots={},
        commits={},
    )
    if transcript is not None:
        state["claude_transcript"] = transcript
    return state


def validate_initial_state(profile, session, state):
    if not isinstance(state, dict) or not isinstance(state.get("session_save"), dict):
        raise NativeError("ENROLLMENT_PUBLICATION_INVALID")
    turn, transcript = state.get("turn"), state.get("claude_transcript")
    date = state.get("session_save", {}).get("date")
    if (
        not isinstance(turn, str)
        or HEX.fullmatch(turn) is None
        or not isinstance(transcript, str)
        or HEX.fullmatch(transcript) is None
        or not isinstance(date, str)
        or datetime.date.fromisoformat(date).isoformat() != date
        or state != initial_session_state(profile, session, turn, transcript, date=date)
    ):
        raise NativeError("ENROLLMENT_PUBLICATION_INVALID")


def reconcile_enrollment(home, profile):
    directory = home / "bindings"
    candidate = select_publication(directory, lambda value: True)
    if candidate is not None:
        record = candidate[2]
        session = record.get("session")
        current, path = read_hot_binding(home, session)
        validate_binding(record, session)
        child = home / "workspaces" / record["workspace"]
        _, descriptor = load_profile(child, inspect=True)
        validate_child(home, profile, child, descriptor)
        if descriptor != child_profile(
            home, profile, record["project"], record["projectMode"]
        ):
            raise NativeError("SESSION_BINDING_INVALID")
        with state_lock(child, session) as (state, _):
            if read_binding(home, session, restore=False)[0] != current:
                raise NativeError("PUBLICATION_CONFLICT")
            if current != record:
                if current is None:
                    if (
                        archive_index(home, session) is not None
                        or "archiveGeneration" in record
                    ):
                        raise NativeError("PUBLICATION_CONFLICT")
                    expected = dict(record, enrolled=False, paused=False)
                    if state is not None:
                        raise NativeError("PUBLICATION_CONFLICT")
                elif (
                    record == dict(current, paused=True) and current["paused"] is False
                ):
                    if current["enrolled"] and state is None:
                        raise NativeError("PUBLICATION_CONFLICT")
                    if state is not None:
                        drain_reasons(state)
                    expected = dict(current, paused=True)
                elif not current["enrolled"] or current["paused"]:
                    validate_initial_state(descriptor, session, state)
                    expected = dict(current, enrolled=True, paused=False)
                else:
                    raise NativeError("PUBLICATION_CONFLICT")
                if record != expected:
                    raise NativeError("PUBLICATION_CONFLICT")
            publish_candidate(
                candidate, path, before=encode(current) if current is not None else None
            )
            clean_retention_temporaries({directory: (candidate[1],)})
    for path in streamed_entries(directory):
        if path.suffix != ".json" or HEX.fullmatch(path.stem) is None:
            raise NativeError("SESSION_BINDING_INVALID")
        record, _ = read_hot_binding(home, path.stem)
        if record["enrolled"] or record["paused"]:
            continue
        if archive_index(home, path.stem) is not None:
            continue
        child, descriptor = bound_child(home, profile, record, inspect=True)
        with state_lock(child, path.stem) as (state, state_path):
            candidate = select_publication(state_path.parent, lambda value: True)
            if candidate is not None:
                validate_initial_state(descriptor, path.stem, candidate[2])
                if state is not None and state != candidate[2]:
                    raise NativeError("PUBLICATION_CONFLICT")
                publish_candidate(candidate, state_path)
                clean_retention_temporaries({state_path.parent: (candidate[1],)})
                state = candidate[2]
            if state is not None:
                validate_initial_state(descriptor, path.stem, state)
                atomic_write(path, encode(dict(record, enrolled=True)))


def retained_capture_event(home, event):
    session = digest(identifier(event.get("session_id")).encode())
    with state_lock(home, session) as (state, _):
        if state is None:
            return False
        normalized = normalize_claude(event, state)
        name = normalized["hook_event_name"]
        if name not in ("PreToolUse", "PostToolUse"):
            return False
        arguments = normalized.get("tool_input")
        tool = normalized.get("tool_name")
        call = normalized.get("tool_use_id")
        if tool == "mcp__obsidian_write__obsidian_keeper_save":
            return (
                bool(state.get("session_request"))
                and arguments == state["session_request"]
                and (name == "PreToolUse" or call == state.get("session_call"))
            )
        if tool == "mcp__obsidian_write__obsidian_daily_append":
            return any(
                pending.get("native_arguments") is not None
                and arguments == pending["native_arguments"]
                and (name == "PreToolUse" or call == pending.get("in_flight"))
                for pending in state["commits"].values()
            )
        return False


def user_hook(home, profile, event):
    try:
        with gate_lock(home, nonblocking=True):
            check_user_state(home)
            reconcile_retention(home)
            reconcile_enrollment(home, profile)
            session = digest(identifier(event.get("session_id")).encode())
            hot, _ = read_hot_binding(home, session)
            index = archive_index(home, session)
            if (
                hot is None
                and index is None
                and event.get("hook_event_name") == "SessionStart"
            ):
                claude_transcript(event)
                return context(
                    "SessionStart",
                    "Obsidian capture awaits UserPromptSubmit; startup does not enroll a session.",
                )
            activation = event.get("hook_event_name") == "UserPromptSubmit"
            if event.get("hook_event_name") == "PreToolUse":
                if hot is None:
                    activation = index is not None
                else:
                    child = home / "workspaces" / hot["workspace"]
                    private_directory(child)
                    with state_lock(child, session) as (state, _):
                        activation = state is None or not drain_reasons(state)
            if activation:
                if event.get("hook_event_name") == "UserPromptSubmit":
                    normalize_claude(event, None)
                active = retire_terminal_sessions(home, profile)
                hot, _ = read_hot_binding(home, session)
                index = archive_index(home, session)
                if hot is None and active >= MAX_DRAIN_SESSIONS:
                    raise NativeError("DRAIN_SESSION_LIMIT")
            record, path = read_binding(home, session)
            project, mode = event_workspace(event)
            key = workspace_key(project, mode)
            if record is not None and record["workspace"] != key:
                raise NativeError("SESSION_WORKSPACE_CHANGED")
            if record is None:
                if event.get("hook_event_name") != "UserPromptSubmit":
                    raise NativeError("PROMPT_EVENT_REQUIRED")
                provision_child(home, profile, project, mode)
                record = dict(
                    schemaVersion=1,
                    session=session,
                    workspace=key,
                    project=project,
                    projectMode=mode,
                    paused=False,
                    enrolled=False,
                )
                bound_child(home, profile, record)
                atomic_write(path, encode(record))
            child, descriptor = bound_child(home, profile, record)
            if any(
                p.name.startswith(".capture-")
                for p in streamed_entries(checked_state_directory(child))
            ):
                raise NativeError("PUBLICATION_AMBIGUOUS")
            if (
                record["paused"]
                and event.get("hook_event_name") != "UserPromptSubmit"
                and not retained_capture_event(child, event)
            ):
                return user_hook_failure(
                    event, "PREVIOUS_CAPTURE_UNRESOLVED; inspect child " + str(child)
                )
            try:
                result = claude_output(
                    engine_hook(child, descriptor, event), event.get("hook_event_name")
                )
            except (
                NativeError,
                OSError,
                RuntimeError,
                ValueError,
                KeyError,
                TypeError,
                subprocess.SubprocessError,
            ):
                if event.get("hook_event_name") == "UserPromptSubmit":
                    record["paused"] = True
                    atomic_write(path, encode(record))
                raise
            if event.get("hook_event_name") == "UserPromptSubmit" and (
                record["paused"] or not record["enrolled"]
            ):
                record["paused"] = False
                record["enrolled"] = True
                atomic_write(path, encode(record))
            if mode == "directory" and event.get("hook_event_name") in (
                "SessionStart",
                "UserPromptSubmit",
            ):
                result.setdefault("hookSpecificOutput", {}).setdefault(
                    "additionalContext", ""
                )
                result["hookSpecificOutput"][
                    "additionalContext"
                ] += "\nGit unavailable for this workspace; session-only capture, no commit inferred."
            return result
    except (
        NativeError,
        OSError,
        RuntimeError,
        ValueError,
        KeyError,
        TypeError,
        subprocess.SubprocessError,
    ) as error:
        return user_hook_failure(
            event,
            (
                str(error)
                if isinstance(error, NativeError)
                else "USER_CAPTURE_UNAVAILABLE"
            ),
        )


def inspect_child_records(home, child):
    with gate_lock(child, nonblocking=True):
        owner = active_request(child)
        for entry in streamed_entries(checked_state_directory(child)):
            if entry.name in (ACTIVE, "active.lock"):
                continue
            if (
                entry.suffix not in (".json", ".lock")
                or HEX.fullmatch(entry.stem) is None
            ):
                raise NativeError("DRAIN_STATE_INVALID")
            with state_lock(child, entry.stem) as (state, _):
                if state is not None:
                    record, _ = read_hot_binding(home, entry.stem)
                    if (
                        record is None
                        or record["workspace"] != child.name
                        or not record["enrolled"]
                    ):
                        raise NativeError("SESSION_BINDING_INVALID")
                    drain_reasons(state)
        return owner


def inspect_provisioning(home, profile):
    directory = home / "provisioning"
    if not directory.exists() and not directory.is_symlink():
        return
    for stage in streamed_entries(directory):
        if HEX.fullmatch(stage.name) is None:
            raise NativeError("CHILD_PROVISIONING_AMBIGUOUS")
        private_directory(stage)
        if any(streamed_entries(checked_state_directory(stage))):
            raise NativeError("CHILD_PROVISIONING_AMBIGUOUS")
        for entry in streamed_entries(stage):
            if entry.name == "capture-state":
                continue
            if entry.name != "capture-profile.json":
                raise NativeError("CHILD_PROVISIONING_AMBIGUOUS")
            descriptor = json.loads(private_read(entry))
            mode = project_mode(descriptor)
            project = descriptor.get("project")
            if stage.name != workspace_key(
                project, mode
            ) or descriptor != child_profile(home, profile, project, mode):
                raise NativeError("CHILD_PROFILE_INVALID")


def unpublished_user_state(home):
    def pending(directory):
        return any(
            entry.name.startswith(".capture-") for entry in streamed_entries(directory)
        )

    if pending(home) or pending(home / "bindings"):
        return True
    for child in streamed_entries(home / "workspaces"):
        private_directory(child)
        if pending(checked_state_directory(child)):
            return True
    stages = home / "provisioning"
    if stages.exists() or stages.is_symlink():
        for stage in streamed_entries(stages):
            if pending(stage):
                return True
    return False


def user_drain_status(home, profile):
    with gate_lock(home, nonblocking=True):
        check_user_state(home)
        if unpublished_user_state(home):
            return dict(
                status="incomplete",
                quiescent=False,
                complete=False,
                reason="PUBLICATION_PENDING",
            )
        if (home / "retention-journal.json").exists() or (
            home / "retention-journal.json"
        ).is_symlink():
            return dict(
                status="incomplete",
                quiescent=False,
                complete=False,
                reason="RETENTION_JOURNAL_PENDING",
            )
        inspect_provisioning(home, profile)
        hot_count = archive_count = workspace_count = unresolved_count = 0
        sessions = []
        workspaces = []
        quiescent = True
        for entry in streamed_entries(home / "bindings"):
            if entry.suffix != ".json" or HEX.fullmatch(entry.stem) is None:
                raise NativeError("SESSION_BINDING_INVALID")
            record, _ = read_binding(home, entry.stem, restore=False)
            if record is None:
                raise NativeError("SESSION_BINDING_INVALID")
            child, _ = bound_child(home, profile, record, inspect=True)
            with state_lock(child, entry.stem) as (state, _):
                reasons = drain_reasons(state) if state is not None else []
                if record["enrolled"] != (state is not None):
                    raise NativeError("SESSION_BINDING_INVALID")
            hot_count += 1
            if reasons:
                unresolved_count += 1
                quiescent = False
                if len(sessions) < MAX_DRAIN_SESSIONS:
                    sessions.append(
                        dict(
                            session=entry.stem,
                            workspace=record["workspace"],
                            unresolved=reasons,
                        )
                    )
        archive = home / "archive"
        if archive.exists() or archive.is_symlink():
            for directory in streamed_entries(archive):
                session = directory.name
                if HEX.fullmatch(session) is None:
                    raise NativeError("RETENTION_ARCHIVE_INVALID")
                index = archive_index(home, session)
                current = archived_record(home, session, index)
                bound_child(home, profile, current["binding"], inspect=True)
                read_binding(home, session, restore=False)
                for entry in streamed_entries(directory):
                    if entry.name == "index.json":
                        continue
                    if entry.suffix != ".json" or HEX.fullmatch(entry.stem) is None:
                        raise NativeError("RETENTION_ARCHIVE_INVALID")
                    validate_archive(
                        json.loads(private_read(entry, limit=RETENTION_LIMIT)),
                        session,
                        entry.stem,
                    )
                if index["location"] == "archive":
                    archive_count += 1
        locators = home / "retained-bindings"
        if locators.exists() or locators.is_symlink():
            for entry in streamed_entries(locators):
                if entry.suffix != ".json" or HEX.fullmatch(entry.stem) is None:
                    raise NativeError("RETENTION_BINDING_INVALID")
                index = archive_index(home, entry.stem)
                if index is None:
                    raise NativeError("RETENTION_ARCHIVE_MISSING")
                retained_locator(
                    home, entry.stem, archived_record(home, entry.stem, index)
                )
        for child in streamed_entries(home / "workspaces"):
            if HEX.fullmatch(child.name) is None:
                raise NativeError("CHILD_PROFILE_INVALID")
            child, descriptor = load_profile(child, inspect=True)
            validate_child(home, profile, child, descriptor)
            owner = inspect_child_records(home, child)
            workspace_count += 1
            if owner is not None:
                record, _ = read_hot_binding(home, owner["session"])
                if record is None or record["workspace"] != child.name:
                    raise NativeError("DRAIN_ACTIVE_STATE_MISSING")
                quiescent = False
            if len(workspaces) < MAX_DRAIN_SESSIONS:
                workspaces.append(dict(workspace=child.name, active_request=owner))
        return dict(
            status="inspected",
            complete=True,
            quiescent=quiescent,
            workspace_count=workspace_count,
            session_count=hot_count + archive_count,
            hot_session_count=hot_count,
            archived_session_count=archive_count,
            unresolved_session_count=unresolved_count,
            sessions=sessions,
            workspaces=workspaces,
            details_truncated=workspace_count > len(workspaces)
            or unresolved_count > len(sessions),
            active_request=None,
        )


def checked_state_directory(home):
    directory = home / "capture-state"
    item = directory.lstat()
    if (
        not stat.S_ISDIR(item.st_mode)
        or directory.is_symlink()
        or item.st_uid != os.getuid()
        or stat.S_IMODE(item.st_mode) != 0o700
    ):
        raise NativeError("STATE_DIRECTORY_INVALID")
    return directory


@contextmanager
def state_lock(home, key, *, create=True):
    if not isinstance(key, str) or HEX.fullmatch(key) is None:
        raise NativeError("SESSION_KEY_INVALID")
    directory = checked_state_directory(home)
    fd = os.open(
        directory / (key + ".lock"),
        (os.O_CREAT if create else 0) | os.O_RDWR | os.O_NOFOLLOW,
        0o600,
    )
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        path = directory / (key + ".json")
        state = (
            json.loads(private_read(path))
            if path.exists() or path.is_symlink()
            else None
        )
        if state is not None and (
            not isinstance(state, dict)
            or state.get("schemaVersion") != 1
            or state.get("session") != key
        ):
            raise NativeError("STATE_INVALID")
        yield state, path
    finally:
        os.close(fd)


@contextmanager
def gate_lock(home, *, nonblocking=False):
    directory = checked_state_directory(home)
    fd = os.open(
        directory / "active.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600
    )
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | (fcntl.LOCK_NB if nonblocking else 0))
        yield directory
    finally:
        os.close(fd)


def active_request(home):
    try:
        value = json.loads(private_read(home / "capture-state" / ACTIVE))
    except FileNotFoundError:
        return None
    except ValueError:
        raise NativeError("ACTIVE_STATE_INVALID")
    if (
        not isinstance(value, dict)
        or value.get("schemaVersion") != 1
        or value.get("reason") != "commit_capture"
        or type(value.get("session")) is not str
        or HEX.fullmatch(value["session"]) is None
        or type(value.get("since")) is not int
        or value["since"] < 0
    ):
        raise NativeError("ACTIVE_STATE_INVALID")
    return value


def drain_reasons(state):
    if (
        not isinstance(state.get("turn"), str)
        or not state["turn"]
        or state.get("disposition") not in ("pending", "saved", "skipped_by_policy")
        or not isinstance(state.get("snapshots"), dict)
        or not isinstance(state.get("commits"), dict)
        or not isinstance(state.get("session_save"), dict)
        or any(not isinstance(p, dict) for p in state["snapshots"].values())
        or not isinstance(state.get("snapshot_resolutions", []), list)
        or not all(isinstance(r, dict) for r in state.get("snapshot_resolutions", []))
    ):
        raise NativeError("DRAIN_STATE_INVALID")
    plan = state["session_save"]
    if any(
        not isinstance(plan.get(k), str) or not plan[k]
        for k in (
            "title",
            "folder",
            "date",
            "path",
            "index",
            "daily",
            "idempotency_key",
        )
    ):
        raise NativeError("DRAIN_STATE_INVALID")
    if state["disposition"] == "saved" and (
        not isinstance(state.get("session_outcome"), dict)
        or state["session_outcome"].get("status") != "saved"
        or state["session_outcome"].get("recovery") != {"required": False}
    ):
        raise NativeError("DRAIN_STATE_INVALID")
    if state["disposition"] == "skipped_by_policy" and (
        state.get("skip_reason")
        not in ("no_meaningful_work", "user_requested_no_capture")
        or state.get("session_request")
    ):
        raise NativeError("DRAIN_STATE_INVALID")
    reasons = []
    if state["disposition"] == "pending":
        reasons.append("session_pending")
    if state.get("session_in_flight") or state.get("session_recovery"):
        reasons.append("session_inflight_or_recovery")
    if state["snapshots"]:
        reasons.append("snapshots")
    for pending in state["commits"].values():
        if (
            not isinstance(pending, dict)
            or pending.get("status")
            not in ("pending", "committed", "skipped", "not_captured")
            or not isinstance(pending.get("event"), dict)
            or not isinstance(pending.get("metadata"), dict)
        ):
            raise NativeError("DRAIN_STATE_INVALID")
        if (
            pending["status"] in ("pending", "not_captured")
            or pending.get("in_flight")
            or pending.get("recovery")
        ):
            reasons.append("commit_pending_or_unresolved")
    if state.get("snapshot_resolutions"):
        reasons.append("uncaptured_snapshot_evidence")
    return sorted(set(reasons))


def drain_status(home):
    # Existing writers lock state before gate; nonblocking state acquisition avoids inversion.
    with gate_lock(home, nonblocking=True) as directory, ExitStack() as locks:
        owner = active_request(home)
        keys = set()
        for entry in directory.iterdir():
            if entry.name in (ACTIVE, "active.lock"):
                continue
            if (
                entry.suffix not in (".json", ".lock")
                or HEX.fullmatch(entry.stem) is None
            ):
                raise NativeError("DRAIN_STATE_INVALID")
            keys.add(entry.stem)
            if len(keys) > MAX_DRAIN_SESSIONS:
                raise NativeError("DRAIN_SESSION_LIMIT")
        sessions = []
        present = set()
        for key in sorted(keys):
            state, _path = locks.enter_context(state_lock(home, key))
            if state is None:
                continue
            present.add(key)
            sessions.append(dict(session=key, unresolved=drain_reasons(state)))
        if owner and owner["session"] not in present:
            raise NativeError("DRAIN_ACTIVE_STATE_MISSING")
        if {p.stem for p in directory.glob("*.json") if p.name != ACTIVE} != present:
            raise NativeError("DRAIN_STATE_CHANGED")
        return dict(
            status="inspected",
            quiescent=owner is None and all(not s["unresolved"] for s in sessions),
            session_count=len(sessions),
            sessions=sessions,
            active_request=owner,
        )


def has_pending_capture(state):
    return bool(state["snapshots"]) or any(
        p["status"] == "pending" for p in state["commits"].values()
    )


def release_gate(directory):
    (directory / ACTIVE).unlink(missing_ok=True)
    descriptor = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def claim_gate(home, session, state):
    with gate_lock(home) as directory:
        owner = active_request(home)
        if has_pending_capture(state):
            if owner is None:
                atomic_write(
                    directory / ACTIVE,
                    encode(
                        dict(
                            schemaVersion=1,
                            session=session,
                            reason="commit_capture",
                            since=int(
                                datetime.datetime.now(datetime.timezone.utc).timestamp()
                            ),
                        )
                    ),
                )
                return None
            return None if owner["session"] == session else owner
        if owner is not None and owner["session"] == session:
            release_gate(directory)
        return None


def settle_gate(home, session, state):
    try:
        owner = claim_gate(home, session, state)
    except NativeError as error:
        if str(error) != "ACTIVE_STATE_INVALID":
            raise
        return (
            "\nThe capture gate file is invalid (ACTIVE_STATE_INVALID), so commits"
            " from other sessions fail until it is cleared. Clear it with takeover --home "
            + str(home)
            + " --session "
            + session
            + " --verification command-stopped-and-history-inspected."
        )
    if owner is None:
        return ""
    return (
        "\nUnexpected capture-gate owner "
        + owner["session"]
        + ": commits from other sessions fail until it is cleared. Clear it with takeover --home "
        + str(home)
        + " --session "
        + session
        + " --verification command-stopped-and-history-inspected."
    )


def persist_with_gate(home, session, state, path):
    if has_pending_capture(state):
        warning = settle_gate(home, session, state)
        atomic_write(path, encode(state))
    else:
        atomic_write(path, encode(state))
        warning = settle_gate(home, session, state)
    return warning


def serialize_denial(name, home, session, owner):
    return {
        "hookSpecificOutput": {
            "hookEventName": name,
            "permissionDecision": "deny",
            "permissionDecisionReason": "Session "
            + owner
            + " owns serialized commit capture for this project. Inspect it with"
            " status --home "
            + str(home)
            + " --session "
            + owner
            + ", then rescue interrupted ownership with takeover --home "
            + str(home)
            + " --session "
            + session
            + " --verification command-stopped-and-history-inspected.",
        }
    }


def input_json():
    def expired(_sig, _frame):
        raise NativeError("INPUT_TIMEOUT")

    signal.signal(signal.SIGALRM, expired)
    signal.alarm(5)
    try:
        raw = sys.stdin.buffer.read(LIMIT + 1)
    finally:
        signal.alarm(0)
    if len(raw) > LIMIT:
        raise NativeError("INPUT_TOO_LARGE")
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise NativeError("INPUT_INVALID")
    return value


def context(event, message):
    return {
        "hookSpecificOutput": {"hookEventName": event, "additionalContext": message}
    }


def shell_commit(command, cwd, project, *, allow_subdirectory=False):
    if not isinstance(command, str):
        return None
    words = shlex.split(command)
    if not words:
        return None
    if Path(words[0]).name == "rtk":
        words.pop(0)
        if words and words[0] == "proxy":
            words.pop(0)
    if not words or words[0] not in ("git", "/usr/bin/git"):
        if any(w in ("git", "/usr/bin/git") for w in words) and "commit" in words:
            raise NativeError(
                "unsupported commit command; use one git -C <root> commit invocation"
            )
        return None
    words.pop(0)
    root = Path(cwd).resolve()
    if words[:1] == ["-C"] and len(words) >= 3:
        root = (root / words[1]).resolve()
        words = words[2:]
    if not words or words[0] != "commit":
        if "commit" in words:
            raise NativeError("unsupported git options before commit")
        return None
    if (
        any(c in command for c in "\n\r;$`|&<>")
        or (root != Path(project) and not allow_subdirectory)
        or any(w in ("-c", "--config-env") for w in words)
    ):
        raise NativeError(
            "unsupported commit command; use one git -C <root> commit invocation"
        )
    if allow_subdirectory and git(root, "rev-parse", "--show-toplevel").strip() != str(
        Path(project)
    ):
        raise NativeError("PROJECT_MISMATCH")
    return root


def reflog(root):
    path = Path(git(root, "rev-parse", "--git-path", "logs/HEAD").strip())
    if not path.is_absolute():
        path = root / path
    if not path.exists():
        return dict(size=0, tail="")
    with path.open("rb") as stream:
        stream.seek(0, 2)
        size = stream.tell()
        stream.seek(max(0, size - 8192))
        tail = stream.read()
    return dict(size=size, tail=digest(tail))


def producer_event(root, before):
    head = git(root, "rev-parse", "--verify", "HEAD", allow_failure=True).strip()
    if head == before["head"]:
        if reflog(root) != before["log"]:
            raise NativeError("COMMIT_AMBIGUOUS")
        return None
    if HASH.fullmatch(head) is None:
        raise NativeError("COMMIT_UNPROVEN")
    path = Path(git(root, "rev-parse", "--git-path", "logs/HEAD").strip())
    if not path.is_absolute():
        path = root / path
    with path.open("rb") as stream:
        stream.seek(max(0, before["log"]["size"] - 8192))
        prefix = stream.read(min(8192, before["log"]["size"]))
        if digest(prefix) != before["log"]["tail"] and before["log"]["size"]:
            raise NativeError("COMMIT_AMBIGUOUS")
        data = stream.read(8193)
    lines = data.splitlines()
    if len(data) > 8192 or len(lines) != 1 or b"\t" not in lines[0]:
        raise NativeError("COMMIT_AMBIGUOUS")
    record, reason = lines[0].split(b"\t", 1)
    hashes = record.split(b" ", 2)
    old = before["head"] or "0" * len(head)
    if hashes[:2] != [old.encode(), head.encode()] or not reason.startswith(
        (b"commit: ", b"commit (initial): ", b"commit (amend): ")
    ):
        raise NativeError("COMMIT_UNPROVEN")
    event = dict(
        schemaVersion=1,
        event="git.commit",
        outcome="success",
        repository=str(root),
        commit=head,
    )
    consumer = runpy.run_path(str(BUNDLE / "bin/obsidian-mcp-capture-commit"))
    return event, consumer["run_producer"](BUNDLE, event, sys.executable)


def session_plan(profile, session, turn, *, date=None):
    date = date or datetime.date.today().isoformat()
    title = "Session " + digest((session + turn).encode())[:20]
    folder = profile["folder"]
    return dict(
        title=title,
        folder=folder,
        date=date,
        path=f"{folder}/{title}.md",
        index=f"{folder}/INDEX.md",
        daily=f"{profile.get('dailyFolder', 'Daily')}/{date}.md",
        idempotency_key="native-session:" + digest((session + "\0" + turn).encode()),
    )


def session_receipt(event, plan):
    if event.get("tool_name") != "mcp__obsidian_write__obsidian_keeper_save":
        return False
    args = event.get("tool_input", {})
    if any(
        args.get(k) != v
        for k, v in dict(
            title=plan["title"],
            folder_hint=plan["folder"],
            session_link_date=plan["date"],
            idempotency_key=plan["idempotency_key"],
            resolved=True,
        ).items()
    ):
        return False
    result = event.get("tool_response")
    if isinstance(result, str):
        result = json.loads(result)
    if not isinstance(result, dict) or result.get("isError", False) is not False:
        return False
    receipt = result.get("structuredContent")
    if receipt is None and isinstance(result.get("content"), list):
        texts = [x.get("text") for x in result["content"] if x.get("type") == "text"]
        if len(texts) == 1:
            receipt = json.loads(texts[0])
    if (
        not isinstance(receipt, dict)
        or not isinstance(receipt.get("recovery"), dict)
        or not isinstance(receipt.get("affected_paths"), list)
    ):
        return False
    required = {
        "status",
        "request_id",
        "idempotency_key",
        "path",
        "affected_paths",
        "warnings",
        "recovery",
        "error_code",
        "retryable",
    }
    if (
        set(receipt) != required
        or not isinstance(receipt.get("request_id"), str)
        or not 1 <= len(receipt["request_id"]) <= 240
        or not isinstance(receipt.get("warnings"), list)
        or len(receipt["warnings"]) > 32
        or not all(isinstance(x, str) and len(x) <= 240 for x in receipt["warnings"])
    ):
        return False
    return (
        receipt.get("status") in ("committed", "skipped")
        and receipt.get("path") == plan["path"]
        and receipt.get("idempotency_key") == plan["idempotency_key"]
        and receipt.get("recovery", {}).get("required") is False
        and receipt.get("recovery", {}).get("action") == ""
        and receipt.get("error_code") is None
        and receipt.get("retryable") is False
        and len(receipt["affected_paths"]) == 3
        and {plan["path"], plan["index"], plan["daily"]}
        == set(receipt["affected_paths"])
    )


def observe_session(state, event):
    plan = state["session_save"]
    arguments = event.get("tool_input", {})
    if arguments.get("idempotency_key") != plan["idempotency_key"]:
        return None
    name = event["hook_event_name"]
    call = identifier(event.get("tool_use_id"))
    reason = None
    expected = dict(
        title=plan["title"],
        folder_hint=plan["folder"],
        session_link_date=plan["date"],
        idempotency_key=plan["idempotency_key"],
        resolved=True,
    )
    if (
        any(arguments.get(k) != v for k, v in expected.items())
        or not isinstance(arguments.get("body"), str)
        or not arguments["body"]
    ):
        reason = "SESSION_REQUEST_INVALID"
    elif state.get("session_request", arguments) != arguments:
        reason = "SESSION_PAYLOAD_CHANGED"
    elif name == "PreToolUse" and state.get("session_recovery"):
        reason = "SESSION_RECOVERY_REVIEW_REQUIRED"
    if name == "PreToolUse":
        if state.get("session_in_flight") not in (None, False, call):
            reason = "SESSION_CALL_IN_FLIGHT"
        if reason:
            return {
                "hookSpecificOutput": {
                    "hookEventName": name,
                    "permissionDecision": "deny",
                    "permissionDecisionReason": reason,
                }
            }
        state["disposition"] = "pending"
        state.pop("skip_reason", None)
        state["session_request"] = arguments
        state["session_payload_digest"] = digest(encode(arguments))
        state["session_call"] = call
        state["session_in_flight"] = call
        return {}
    if name != "PostToolUse":
        return None
    if state.get("session_call") != call:
        return context(
            name,
            "Session receipt did not match the prepared native call; capture remains unresolved.",
        )
    state.setdefault("session_request", arguments)
    state.setdefault("session_payload_digest", digest(encode(arguments)))
    try:
        success = not reason and session_receipt(event, plan)
    except (ValueError, TypeError, KeyError, AttributeError):
        success = False
    state["session_recovery"] = not success
    state["session_in_flight"] = False
    state["session_outcome"] = {
        "status": "saved" if success else "unresolved",
        "path": plan["path"],
        "idempotency_key": plan["idempotency_key"],
        "recovery": {"required": not success},
    }
    result = event.get("tool_response")
    if isinstance(result, dict) and isinstance(result.get("structuredContent"), dict):
        receipt = result["structuredContent"]
        if receipt.get("status") in ("partial", "conflict", "failed"):
            state["session_outcome"]["status"] = receipt["status"]
            code = receipt.get("error_code")
            if isinstance(code, str) and re.fullmatch(r"[A-Z_]{1,64}", code):
                state["session_outcome"]["error_code"] = code
    if success:
        state["disposition"] = "saved"
    return {}


def commit_routes(profile):
    if "commitRoutes" not in profile:
        return {}
    if profile.get("host") != "claude-plugin":
        raise NativeError("COMMIT_ROUTES_HOST_UNSUPPORTED")
    consumer = runpy.run_path(str(BUNDLE / "bin/obsidian-mcp-capture-commit"))
    try:
        return consumer["validate_commit_routes"](profile.get("commitRoutes", {}))
    except consumer["CaptureError"]:
        raise NativeError("COMMIT_ROUTES_INVALID") from None


def pending_target(pending, consumer, routes=None):
    try:
        if "native_arguments" in pending:
            return consumer["validate_capture_path"](
                pending["native_arguments"]["target_path"]
            )
        if "capture_path" in pending:
            return consumer["validate_capture_path"](pending["capture_path"])
        canonical = consumer["capture_target"](pending["metadata"])
        if canonical != consumer["capture_target"](pending["metadata"], routes):
            raise NativeError("COMMIT_ROUTE_RECONCILIATION_REQUIRED")
        return canonical
    except consumer["CaptureError"]:
        raise NativeError("COMMIT_ROUTES_INVALID") from None


def capture_guidance(home, state, host="codex", routes=None):
    key = state["session"]
    plan = state["session_save"]
    commands = []
    tool_prefix = (
        "mcp__obsidian-write__" if host == "claude-plugin" else "mcp__obsidian_write__"
    )
    for event_id, pending in state["commits"].items():
        if pending["status"] == "pending":
            if host == "claude-plugin":
                arguments = pending.get("native_arguments")
                if arguments is None:
                    consumer = runpy.run_path(
                        str(BUNDLE / "bin/obsidian-mcp-capture-commit")
                    )
                    _, arguments = consumer["capture_arguments"](
                        pending["metadata"],
                        COMMIT_CONTEXT_TEMPLATE,
                        target_path=pending_target(pending, consumer, routes),
                    )
                    instruction = (
                        "Replace the three placeholder bullets with 3-8 concise factual context bullets. "
                        "Preserve the Branch line and every other argument exactly. "
                    )
                else:
                    instruction = "Preserve these prepared arguments exactly. "
                commands.append(
                    f"Capture the pending commit through {tool_prefix}obsidian_daily_append before another commit. "
                    + instruction
                    + "Call MCP directly; no shell preparation is needed. Inspect the result; do not claim capture on failure. "
                    "An in-flight or recovery outcome requires inspection before retry.\n"
                    "Commit capture arguments: "
                    + json.dumps(arguments, ensure_ascii=False)
                )
                continue
            command = shlex.join(
                [
                    state["python"],
                    str(BUNDLE / "bin/obsidian-mcp-native"),
                    "prepare",
                    "--home",
                    str(home),
                    "--session",
                    key,
                    "--commit",
                    event_id,
                ]
            )
            commands.append(
                f'Prepare the pending commit before another commit: pipe JSON {{"context":[3-8 concise factual context bullets]}} to {command}, then call mcp__obsidian_write__obsidian_daily_append with the returned exact arguments. Inspect its result; do not claim capture on failure.'
            )
    if state["disposition"] == "pending":
        commands.append(
            f"Save meaningful session work through {tool_prefix}obsidian_keeper_save using "
            + json.dumps(
                {
                    k: plan[v]
                    for k, v in (
                        ("title", "title"),
                        ("folder_hint", "folder"),
                        ("session_link_date", "date"),
                        ("idempotency_key", "idempotency_key"),
                    )
                }
            )
            + ", resolved=true, and a factual Markdown body. Preserve this payload on retry; inspect partial/recovery/conflict outcomes."
        )
        command = shlex.join(
            [
                state["python"],
                str(BUNDLE / "bin/obsidian-mcp-native"),
                "skip",
                "--home",
                str(home),
                "--session",
                key,
                "--turn",
                state["turn"],
            ]
        )
        commands.append(
            f"Only for no meaningful work or user-requested no capture, acknowledge explicitly with {command} --reason no_meaningful_work (or user_requested_no_capture). Planning/review can be meaningful without edits."
        )
    if state.get("snapshots"):
        commands.append(
            "An unfinished commit tool event remains unresolved. After confirming the tool stopped and inspecting local history, use resolve-snapshot with the exact snapshot ID from status; this records an uncaptured event, never a successful capture."
        )
    return "\n".join(commands)


def claude_transcript(event, *, watermark=False):
    value = event.get("transcript_path")
    if not isinstance(value, str) or not value or len(value.encode()) > 4096:
        raise NativeError("TRANSCRIPT_PATH_INVALID")
    path = Path(value).expanduser()
    if not path.is_absolute() or path.is_symlink():
        raise NativeError("TRANSCRIPT_PATH_INVALID")
    identity = digest(str(path.resolve()).encode())
    if not watermark:
        return identity
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return dict(identity=identity, offset=0, tail=digest(b""))
    with os.fdopen(descriptor, "rb") as stream:
        before = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_uid != os.getuid()
            or before.st_nlink != 1
        ):
            raise NativeError("TRANSCRIPT_FILE_INVALID")
        stream.seek(max(0, before.st_size - 65536))
        tail = stream.read(65536)
        after = os.fstat(stream.fileno())
        if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
            raise NativeError("TRANSCRIPT_CHANGED_DURING_READ")
    return dict(
        identity=identity,
        file=digest(encode([before.st_dev, before.st_ino])),
        offset=before.st_size,
        tail=digest(tail),
    )


def normalize_claude(event, state):
    name = event.get("hook_event_name")
    if name not in CLAUDE_EVENTS:
        raise NativeError("HOOK_EVENT_UNSUPPORTED")
    if event.get("agent_id"):
        raise NativeError("SUBAGENT_CAPTURE_UNSUPPORTED")
    if state:
        drain_reasons(state)
    identity = claude_transcript(event)
    if state and state.get("claude_transcript") != identity:
        raise NativeError("TRANSCRIPT_IDENTITY_CHANGED")
    normalized = dict(event)
    if name == "UserPromptSubmit":
        prompt = event.get("prompt")
        if not isinstance(prompt, str):
            raise NativeError("PROMPT_INVALID")
        occurrence = digest(
            encode(
                [
                    digest(identifier(event.get("session_id")).encode()),
                    claude_transcript(event, watermark=True),
                    digest(prompt.encode()),
                ]
            )
        )
        continuation = (
            state
            and state.get("continuation_requested")
            and prompt.startswith("OBSIDIAN_MCP_CONTINUE:" + state["turn"] + "\n")
        )
        normalized["turn_id"] = state["turn"] if continuation else occurrence
        normalized["claude_transcript"] = identity
    else:
        if not state:
            raise NativeError("PROMPT_EVENT_REQUIRED")
        normalized["turn_id"] = state["turn"]
    if name in ("PreToolUse", "PostToolUse", "PostToolUseFailure"):
        identifier(event.get("tool_use_id"))
        if not isinstance(event.get("tool_input"), dict) or not isinstance(
            event.get("tool_name"), str
        ):
            raise NativeError("TOOL_EVENT_INVALID")
        tool = event["tool_name"]
        if tool in CLAUDE_TOOLS.values():
            raise NativeError("MCP_ALIAS_UNSUPPORTED")
        normalized["tool_name"] = CLAUDE_TOOLS.get(tool, tool)
        if name == "PostToolUseFailure":
            normalized.update(
                hook_event_name="PostToolUse",
                tool_response={"isError": True},
                host_tool_failed=True,
            )
        elif name == "PostToolUse" and tool in CLAUDE_TOOLS:
            response = event.get("tool_response")
            if isinstance(response, str):
                try:
                    response = json.loads(response)
                except ValueError:
                    response = None
            if isinstance(response, list):
                normalized["tool_response"] = {"content": response}
            elif isinstance(response, dict):
                normalized["tool_response"] = (
                    {"structuredContent": response}
                    if "status" in response and "recovery" in response
                    else response
                )
    if name == "Stop" and type(event.get("stop_hook_active")) is not bool:
        raise NativeError("STOP_EVENT_INVALID")
    return normalized


def claude_output(value, name):
    if isinstance(value, dict):
        output = {}
        for key, item in value.items():
            if key == "hookEventName":
                output[key] = name
            else:
                output[key] = claude_output(item, name)
        if output.get("permissionDecision") == "allow" and "updatedInput" in output:
            output.pop("permissionDecision")
        if "hookEventName" in output:
            output["hookEventName"] = name
        return output
    if isinstance(value, list):
        return [claude_output(v, name) for v in value]
    return value


def hook(home, profile, event):
    if capture_scope(profile) == "user":
        return user_hook(home, profile, event)
    if profile["host"] != "claude-plugin":
        return engine_hook(home, profile, event)
    name = event.get("hook_event_name")
    try:
        return claude_output(engine_hook(home, profile, event), name)
    except (
        NativeError,
        OSError,
        RuntimeError,
        ValueError,
        KeyError,
        TypeError,
        subprocess.SubprocessError,
    ) as error:
        code = (
            str(error)
            if isinstance(error, NativeError)
            else "HOOK_STATE_OR_EVENT_INVALID"
        )
        message = "Obsidian capture unresolved: " + code
        if name == "PreToolUse" and event.get("tool_name") in (
            *CLAUDE_TOOLS,
            *CLAUDE_TOOLS.values(),
        ):
            return {
                "hookSpecificOutput": dict(
                    hookEventName=name,
                    permissionDecision="deny",
                    permissionDecisionReason=message,
                )
            }
        if name == "Stop":
            return dict(systemMessage=message)
        return context(name, message)


def engine_hook(home, profile, event):
    name = event.get("hook_event_name")
    session = digest(identifier(event.get("session_id")).encode())
    cwd = event.get("cwd", "")
    mode = project_mode(profile)
    routes = commit_routes(profile)
    if mode == "directory":
        try:
            if not isinstance(cwd, str) or not cwd or not Path(cwd).is_absolute():
                raise NativeError("PROJECT_MISMATCH")
            directory = Path(cwd).resolve(strict=True)
            if not directory.is_dir() or not directory.is_relative_to(
                Path(profile["project"])
            ):
                raise NativeError("PROJECT_MISMATCH")
        except (OSError, RuntimeError):
            raise NativeError("PROJECT_MISMATCH") from None
        directory_session_event(event)
    elif profile["host"] == "claude-plugin":
        if (
            not isinstance(cwd, str)
            or not cwd
            or not Path(cwd).is_absolute()
            or git(Path(cwd).resolve(), "rev-parse", "--show-toplevel").strip()
            != profile["project"]
        ):
            raise NativeError("PROJECT_MISMATCH")
    elif Path(cwd).resolve() != Path(profile["project"]):
        raise NativeError("PROJECT_MISMATCH")
    with state_lock(home, session) as (state, path):
        if profile["host"] == "claude-plugin":
            if name == "SessionStart" and state is None:
                claude_transcript(event)
                return context(
                    name,
                    "Obsidian capture awaits UserPromptSubmit; no turn inferred on startup or resume.",
                )
            event = normalize_claude(event, state)
            name = event["hook_event_name"]
            if name in ("SessionStart", "StopFailure"):
                return context(
                    name,
                    "Obsidian persisted capture state retained.\n"
                    + capture_guidance(home, state, profile["host"], routes),
                )
        turn = identifier(event.get("turn_id"))
        if name == "UserPromptSubmit":
            prompt = event.get("prompt", "")
            continuation = state and prompt.startswith(
                "OBSIDIAN_MCP_CONTINUE:" + state["turn"] + "\n"
            )
            if not continuation and (state is None or state["turn"] != turn):
                if state and (
                    state["disposition"] == "pending"
                    or state.get("session_recovery")
                    or state.get("snapshots")
                    or any(
                        p["status"] in ("pending", "not_captured")
                        for p in state["commits"].values()
                    )
                    or state.get("snapshot_resolutions")
                ):
                    raise NativeError("PREVIOUS_CAPTURE_UNRESOLVED")
                if (
                    state
                    and profile["host"] == "claude-plugin"
                    and drain_reasons(state)
                ):
                    raise NativeError("PREVIOUS_CAPTURE_UNRESOLVED")
                state = initial_session_state(
                    profile,
                    session,
                    turn,
                    (
                        event["claude_transcript"]
                        if profile["host"] == "claude-plugin"
                        else None
                    ),
                )
            atomic_write(path, encode(state))
            return context(
                name,
                (
                    "This capture profile uses MCP only; plugin ownership is managed separately.\n"
                    if profile["host"] == "claude-plugin"
                    else "This isolated profile owns capture through MCP only.\n"
                )
                + capture_guidance(home, state, profile["host"], routes),
            )
        if state is None:
            raise NativeError("PROMPT_EVENT_REQUIRED")
        if name == "Stop":
            guidance = capture_guidance(home, state, profile["host"], routes)
            if not guidance:
                return {}
            if event.get("stop_hook_active") is not False or state.get(
                "continuation_requested"
            ):
                return {
                    "systemMessage": "Obsidian capture unresolved; no successful receipt or policy skip. "
                    + guidance
                }
            state["continuation_requested"] = True
            atomic_write(path, encode(state))
            return {
                "decision": "block",
                "reason": "OBSIDIAN_MCP_CONTINUE:" + state["turn"] + "\n" + guidance,
            }
        if event.get("tool_name") == "mcp__obsidian_write__obsidian_keeper_save":
            result = observe_session(state, event)
            if result is not None:
                atomic_write(path, encode(state))
                return result
        if (
            mode == "git"
            and event.get("tool_name") == "mcp__obsidian_write__obsidian_daily_append"
        ):
            result = observe_commit(
                state,
                event,
                attached=profile["host"] == "claude-plugin",
                routes=routes,
            )
            if result is not None:
                atomic_write(path, encode(state))
                note = settle_gate(home, session, state)
                if not note:
                    return result
                note = note.lstrip("\n")
                if result == {}:
                    return context(name, note)
                output = result.get("hookSpecificOutput", {})
                if "additionalContext" in output:
                    output["additionalContext"] += "\n" + note
                return result
        if mode == "directory":
            return {}
        if (
            name not in ("PreToolUse", "PostToolUse")
            or event.get("tool_name") != "Bash"
        ):
            return {}
        command = event.get("tool_input", {}).get("command")
        call = identifier(event.get("tool_use_id"))
        wrapped_snapshot = next(
            (
                (key, value)
                for key, value in state["snapshots"].items()
                if value.get("call") == call
                and command in (value.get("wrapped"), value.get("command"))
            ),
            None,
        )
        if name == "PostToolUse" and wrapped_snapshot:
            fingerprint, before = wrapped_snapshot
            if event.get("host_tool_failed"):
                before["host_failure"] = True
                atomic_write(path, encode(state))
                return context(
                    name,
                    "Commit tool failed; executor evidence retained for inspection. No capture inferred.",
                )
            if not before.get("execution_started"):
                try:
                    unchanged = producer_event(Path(profile["project"]), before) is None
                except Exception:
                    unchanged = False
                if not unchanged:
                    return context(
                        name,
                        "Commit executor did not run; Git effects are unresolved. Retain the snapshot for inspection.",
                    )
                state["snapshots"].pop(fingerprint)
                return context(
                    name,
                    "Commit executor did not run; no event captured."
                    + persist_with_gate(home, session, state, path),
                )
            if "exit_code" not in before or before.get("capture_error"):
                return context(
                    name,
                    "Commit execution outcome unavailable; inspect the outstanding snapshot before resolving it.",
                )
            if (
                before.get("capture_error")
                or before.get("effects_verified") is not True
            ):
                return context(
                    name,
                    "Commit effects remain unresolved; inspect the retained snapshot and local history.",
                )
            if before["exit_code"] == 0 and before.get("captured"):
                event_data, metadata = before["captured"]
                consumer = runpy.run_path(
                    str(BUNDLE / "bin/obsidian-mcp-capture-commit")
                )
                pending = dict(event=event_data, metadata=metadata, status="pending")
                if "capture_path" in before:
                    pending["capture_path"] = before["capture_path"]
                pending["capture_path"] = pending_target(pending, consumer, routes)
                state["commits"][digest(encode(event_data))] = pending
            state["snapshots"].pop(fingerprint)
            note = persist_with_gate(home, session, state, path)
            return context(
                name,
                capture_guidance(home, state, profile["host"], routes) + note,
            )
        try:
            root = shell_commit(
                command,
                event["cwd"],
                profile["project"],
                allow_subdirectory=profile["host"] == "claude-plugin",
            )
        except NativeError as error:
            if name == "PreToolUse" and (
                state["snapshots"]
                or any(p["status"] == "pending" for p in state["commits"].values())
            ):
                return {
                    "hookSpecificOutput": {
                        "hookEventName": name,
                        "permissionDecision": "deny",
                        "permissionDecisionReason": "Resolve the outstanding commit event before another commit.",
                    }
                }
            return context(name, "Obsidian commit not captured: " + str(error))
        if root is None:
            return {}
        fingerprint = digest(encode([call, command]))
        if name == "PreToolUse":
            if fingerprint in state["snapshots"]:
                return {
                    "hookSpecificOutput": {
                        "hookEventName": name,
                        "permissionDecision": "allow",
                        "updatedInput": dict(
                            event["tool_input"],
                            command=state["snapshots"][fingerprint]["wrapped"],
                        ),
                    }
                }
            if state["snapshots"]:
                return {
                    "hookSpecificOutput": {
                        "hookEventName": name,
                        "permissionDecision": "deny",
                        "permissionDecisionReason": "A previous commit tool call has not completed; wait or inspect its outcome.",
                    }
                }
            if any(p["status"] == "pending" for p in state["commits"].values()):
                return {
                    "hookSpecificOutput": {
                        "hookEventName": name,
                        "permissionDecision": "deny",
                        "permissionDecisionReason": "Capture or resolve the pending commit before creating another commit.\n"
                        + capture_guidance(home, state, profile["host"], routes),
                    }
                }
            other = active_request(home)
            if other is not None and other["session"] != session:
                return serialize_denial(name, home, session, other["session"])
            if len(state["snapshots"]) >= MAX_PENDING:
                raise NativeError("PENDING_LIMIT")
            wrapped = shlex.join(
                [
                    profile["python"],
                    str(BUNDLE / "bin/obsidian-mcp-native"),
                    "execute-commit",
                    "--home",
                    str(home),
                    "--session",
                    session,
                    "--snapshot",
                    fingerprint,
                ]
            )
            state["snapshots"][fingerprint] = dict(
                call=call,
                command=command,
                wrapped=wrapped,
                head=git(
                    root, "rev-parse", "--verify", "HEAD", allow_failure=True
                ).strip(),
                log=reflog(root),
            )
            if profile["host"] == "claude-plugin":
                state["snapshots"][fingerprint]["cwd"] = str(
                    Path(event["cwd"]).resolve()
                )
            other = claim_gate(home, session, state)
            if other is not None:
                state["snapshots"].pop(fingerprint, None)
                atomic_write(path, encode(state))
                return serialize_denial(name, home, session, other["session"])
            atomic_write(path, encode(state))
            return {
                "hookSpecificOutput": {
                    "hookEventName": name,
                    "permissionDecision": "allow",
                    "updatedInput": dict(event["tool_input"], command=wrapped),
                }
            }
        return context(
            name, "Obsidian commit not captured: matching executor record unavailable"
        )


def prepare_pending(pending, payload, consumer, *, producer_timeout=None, routes=None):
    target = pending_target(pending, consumer, routes)
    items = payload.get("context")
    if (
        set(payload) != {"context"}
        or not isinstance(items, list)
        or not 1 <= len(items) <= consumer["CONTEXT_ITEMS"]
        or not all(
            consumer["bounded_utf8"](
                item, consumer["CONTEXT_ITEM_LIMIT"], allow_empty=False
            )
            and not any(ord(c) < 32 or ord(c) == 127 for c in item)
            for item in items
        )
        or sum(len(item.encode()) for item in items) > consumer["CONTEXT_LIMIT"]
    ):
        raise NativeError("CONTEXT_INVALID")
    payload_digest = digest(encode(payload))
    if pending.get("payload_digest", payload_digest) != payload_digest:
        raise NativeError("COMMIT_PAYLOAD_CHANGED")
    if pending["status"] != "pending":
        return {"status": "skipped", "path": pending.get("path")}
    if pending.get("in_flight") or pending.get("recovery"):
        raise NativeError("COMMIT_RECOVERY_REQUIRED")
    try:
        consumer["run_producer"](
            BUNDLE,
            pending["event"],
            sys.executable,
            timeout=(
                consumer["PRODUCER_TIMEOUT"]
                if producer_timeout is None
                else producer_timeout
            ),
        )
    except consumer["CaptureError"]:
        raise NativeError("COMMIT_EVENT_REJECTED; commit must still be HEAD") from None
    if "native_arguments" in pending:
        return {
            "tool": "obsidian_daily_append",
            "arguments": pending["native_arguments"],
        }
    target, arguments = consumer["capture_arguments"](
        pending["metadata"], items, target_path=target
    )
    pending.update(
        request=payload,
        payload_digest=payload_digest,
        native_arguments=arguments,
        path=target,
    )
    return {"tool": "obsidian_daily_append", "arguments": arguments}


def directory_session_event(event):
    if event.get("tool_name") not in (
        "mcp__obsidian-write__obsidian_daily_append",
        "mcp__obsidian_write__obsidian_daily_append",
    ):
        return
    arguments = event.get("tool_input", {})
    if not isinstance(arguments, dict):
        raise NativeError("TOOL_EVENT_INVALID")
    key = arguments.get("idempotency_key")
    if arguments.get("skip_if_hash") is not None or (
        isinstance(key, str) and key.startswith("commit-capture:")
    ):
        raise NativeError("DIRECTORY_SESSION_ONLY")


def prepare_commit(home, profile, args):
    require_git_profile(profile)
    consumer = runpy.run_path(str(BUNDLE / "bin/obsidian-mcp-capture-commit"))
    payload = input_json()
    with state_lock(home, args.session) as (state, path):
        if state is None or args.commit not in state["commits"]:
            raise NativeError("COMMIT_EVENT_UNAVAILABLE")
        result = prepare_pending(
            state["commits"][args.commit],
            payload,
            consumer,
            routes=commit_routes(profile),
        )
        atomic_write(path, encode(state))
    return result


def execute_commit(home, profile, args, parent_locks=None):
    require_git_profile(profile)
    with state_lock(home, args.session) as (state, path):
        if state is None or args.snapshot not in state["snapshots"]:
            raise NativeError("SNAPSHOT_UNAVAILABLE")
        before = state["snapshots"][args.snapshot]
        if "exit_code" in before:
            if (
                before.get("capture_error")
                or before.get("effects_verified") is not True
            ):
                raise NativeError("COMMIT_EXECUTION_UNRESOLVED")
            return before["exit_code"]
        if before.get("execution_started"):
            raise NativeError("COMMIT_EXECUTION_UNRESOLVED")
        execution_cwd = before.get("cwd", profile["project"])
        root = shell_commit(
            before["command"],
            execution_cwd,
            profile["project"],
            allow_subdirectory=profile["host"] == "claude-plugin",
        )
        if root is None:
            raise NativeError("COMMIT_COMMAND_INVALID")
        words = shlex.split(before["command"])
        if Path(words[0]).name == "rtk":
            words.pop(0)
            if words[0] == "proxy":
                words.pop(0)
        before["execution_started"] = True
        atomic_write(path, encode(state))
        if parent_locks is not None:
            parent_locks.close()
        producer = runpy.run_path(str(BUNDLE / "bin/obsidian-mcp-commit-event"))
        environment = producer["isolated_environment"]()
        for role in ("AUTHOR", "COMMITTER"):
            for field in ("NAME", "EMAIL", "DATE"):
                key = f"GIT_{role}_{field}"
                if key in os.environ:
                    environment[key] = os.environ[key]
        try:
            result = subprocess.run(
                words, cwd=execution_cwd, env=environment, timeout=300, check=False
            )
        except (OSError, subprocess.SubprocessError):
            raise NativeError("COMMIT_EXECUTION_UNRESOLVED") from None
        before["exit_code"] = result.returncode
        try:
            observed = producer_event(Path(profile["project"]), before)
            if result.returncode != 0 and observed is not None:
                raise NativeError("NONZERO_EXIT_WITH_COMMIT")
            if observed is not None:
                consumer = runpy.run_path(
                    str(BUNDLE / "bin/obsidian-mcp-capture-commit")
                )
                before["capture_path"] = consumer["capture_target"](
                    observed[1], commit_routes(profile)
                )
            before["captured"] = observed
            before["effects_verified"] = True
        except Exception as error:
            before["capture_error"] = type(error).__name__
            atomic_write(path, encode(state))
            raise NativeError("COMMIT_EVENT_UNPROVEN; inspect snapshot") from None
        atomic_write(path, encode(state))
        return result.returncode


def normalized_result(event):
    result = event.get("tool_response")
    if isinstance(result, str):
        result = json.loads(result)
    if not isinstance(result, dict):
        raise NativeError("RECEIPT_INVALID")
    texts = [
        x.get("text")
        for x in result.get("content", [])
        if isinstance(x, dict) and x.get("type") == "text"
    ]
    envelope = result.get("structuredContent")
    if envelope is None and len(texts) == 1:
        envelope = json.loads(texts[0])
    if not isinstance(envelope, dict):
        raise NativeError("RECEIPT_INVALID")
    return dict(
        result, structuredContent=envelope, isError=result.get("isError", False)
    )


def observe_commit(state, event, *, attached=False, routes=None):
    arguments = event.get("tool_input", {})
    consumer = (
        runpy.run_path(str(BUNDLE / "bin/obsidian-mcp-capture-commit"))
        if attached
        else None
    )
    matches = []
    for pending in state["commits"].values():
        planned = pending.get("native_arguments", {})
        if attached and "native_arguments" not in pending:
            _, planned = consumer["capture_arguments"](
                pending["metadata"],
                [],
                target_path=pending_target(pending, consumer, routes),
            )
        if arguments.get("idempotency_key") and arguments[
            "idempotency_key"
        ] == planned.get("idempotency_key"):
            matches.append(pending)
    if len(matches) != 1:
        if matches and attached and event["hook_event_name"] == "PreToolUse":
            raise NativeError("COMMIT_EVENT_AMBIGUOUS")
        return None
    pending = matches[0]
    name = event["hook_event_name"]
    call = identifier(event.get("tool_use_id"))
    if name == "PreToolUse":
        if attached and "native_arguments" not in pending:
            content = arguments.get("content")
            if not isinstance(content, str):
                raise NativeError("CONTEXT_INVALID")
            lines = content.split("\n")
            if not all(line.startswith("- ") for line in lines):
                raise NativeError("CONTEXT_INVALID")
            items = [line[2:] for line in lines[1:]]
            if any(item in COMMIT_CONTEXT_TEMPLATE for item in items):
                raise NativeError("CONTEXT_INVALID")
            _, expected = consumer["capture_arguments"](
                pending["metadata"],
                items,
                target_path=pending_target(pending, consumer, routes),
            )
            if arguments != expected:
                raise NativeError("COMMIT_PAYLOAD_CHANGED")
            result = prepare_pending(
                pending,
                {"context": items},
                consumer,
                producer_timeout=CLAUDE_PRODUCER_TIMEOUT,
                routes=routes,
            )
            if "arguments" not in result:
                raise NativeError("COMMIT_EVENT_UNAVAILABLE")
        reason = None
        if arguments != pending["native_arguments"]:
            reason = "COMMIT_PAYLOAD_CHANGED"
        elif pending.get("recovery") or pending.get("in_flight") not in (
            None,
            False,
            call,
        ):
            reason = "COMMIT_RECOVERY_REVIEW_REQUIRED"
        if reason:
            return {
                "hookSpecificOutput": {
                    "hookEventName": name,
                    "permissionDecision": "deny",
                    "permissionDecisionReason": reason,
                }
            }
        pending["in_flight"] = call
        return {}
    if name != "PostToolUse":
        return None
    if pending.get("in_flight") != call or arguments != pending["native_arguments"]:
        return context(
            name,
            "Commit receipt did not match the prepared native call; capture remains unresolved.",
        )
    consumer = consumer or runpy.run_path(
        str(BUNDLE / "bin/obsidian-mcp-capture-commit")
    )
    contract = json.loads((BUNDLE / "contract.json").read_bytes())
    errors = frozenset(contract["tools"]["obsidian_daily_append"]["errors"])
    try:
        result = normalized_result(event)
        status = consumer["validate_outcome"](
            result, pending["path"], arguments, errors
        )
    except consumer["CaptureError"] as error:
        pending["recovery"] = error.envelope or consumer["unknown_outcome"](
            "RECEIPT_INVALID", pending["path"], arguments
        )
    except (NativeError, ValueError, TypeError, KeyError):
        pending["recovery"] = consumer["unknown_outcome"](
            "RECEIPT_INVALID", pending["path"], arguments
        )
    else:
        pending.update(status=status, recovery=None)
    pending["in_flight"] = False
    return {}


def review_retry(home, profile, args):
    if args.commit is not None:
        require_git_profile(profile)
    if args.verification != "authoritative-path-inspected":
        raise NativeError("AUTHORITATIVE_VERIFICATION_REQUIRED")
    with state_lock(home, args.session) as (state, path):
        if state is None:
            raise NativeError("SESSION_UNAVAILABLE")
        if args.commit:
            pending = state["commits"].get(args.commit)
            if not pending or pending.get("payload_digest") != args.payload_sha256:
                raise NativeError("PAYLOAD_DIGEST_MISMATCH")
            payload = pending["request"]
            pending.update(recovery=None, in_flight=False)
        else:
            if state.get("session_payload_digest") != args.payload_sha256:
                raise NativeError("PAYLOAD_DIGEST_MISMATCH")
            state["session_recovery"] = False
            state["session_in_flight"] = False
            payload = state["session_request"]
        reviews = state.setdefault("recovery_reviews", [])
        if len(reviews) >= MAX_PENDING:
            raise NativeError("RECOVERY_REVIEW_LIMIT")
        reviews.append(
            dict(
                payload_sha256=args.payload_sha256,
                commit=args.commit,
                verification=args.verification,
            )
        )
        atomic_write(path, encode(state))
    if args.commit:
        return {
            "tool": "obsidian_daily_append",
            "arguments": pending["native_arguments"],
        }
    return payload


def takeover(home, profile, args):
    require_git_profile(profile)
    if args.verification != "command-stopped-and-history-inspected":
        raise NativeError("INTERRUPTED_VERIFICATION_REQUIRED")
    if args.session is not None and HEX.fullmatch(args.session) is None:
        raise NativeError("SESSION_KEY_INVALID")
    with gate_lock(home) as directory:
        try:
            owner = active_request(home)
        except NativeError as error:
            if str(error) != "ACTIVE_STATE_INVALID":
                raise
            release_gate(directory)
            return dict(status="cleared_invalid_gate")
        if owner is None or owner["session"] == args.session:
            raise NativeError("INTERRUPTED_OWNERSHIP_REQUIRED")
    owner_session = owner["session"]
    result = dict(status="recovered_no_pending", owner=owner_session, commits=[])
    with state_lock(home, owner_session) as (state, path):
        with gate_lock(home):
            current = active_request(home)
            if current is None or current["session"] != owner_session:
                raise NativeError("INTERRUPTED_OWNERSHIP_CHANGED")
        if state is None:
            result["status"] = "recovered_owner_state_missing"
        elif has_pending_capture(state):
            history = state.setdefault("snapshot_resolutions", [])
            if len(history) >= MAX_PENDING:
                raise NativeError("SNAPSHOT_RESOLUTION_LIMIT")
            observed_head = git(
                Path(profile["project"]),
                "rev-parse",
                "--verify",
                "HEAD",
                allow_failure=True,
            ).strip()
            record = dict(
                owner=owner_session,
                taken_over_by=args.session,
                observed_head=observed_head or None,
                verification=args.verification,
                status="not_captured",
                snapshots=dict(state["snapshots"]),
                commits=[
                    key
                    for key, pending in state["commits"].items()
                    if pending["status"] == "pending"
                ],
            )
            state["snapshots"] = {}
            for key in record["commits"]:
                state["commits"][key].update(status="not_captured", in_flight=False)
            history.append(record)
            atomic_write(path, encode(state))
            result["status"] = "recovered"
            result.update(
                commits=record["commits"],
                snapshots=list(record["snapshots"]),
                observed_head=record["observed_head"],
                head_unavailable=observed_head == "",
            )
        with gate_lock(home) as directory:
            release_gate(directory)
    return result


def main():
    parser = ArgumentParser(description=__doc__)
    parser.add_argument(
        "operation",
        choices=(
            "create",
            "attach",
            "capabilities",
            "profile-status",
            "drain-status",
            "execute-commit",
            "hook",
            "prepare",
            "retry",
            "request",
            "resolve-snapshot",
            "skip",
            "takeover",
            "status",
            "disable",
            "run",
        ),
    )
    parser.add_argument("--home")
    parser.add_argument("--host", choices=("codex", "claude-plugin"))
    parser.add_argument("--project")
    parser.add_argument("--scope", choices=("project", "user"), default="project")
    parser.add_argument("--project-mode", choices=("git", "directory"))
    parser.add_argument("--folder")
    parser.add_argument("--daily-folder", default="Daily")
    parser.add_argument("--release-sha256")
    parser.add_argument("--session")
    parser.add_argument("--turn")
    parser.add_argument("--commit")
    parser.add_argument("--commit-routes")
    parser.add_argument("--snapshot")
    parser.add_argument("--payload-sha256")
    parser.add_argument(
        "--verification",
        choices=(
            "authoritative-path-inspected",
            "command-stopped-and-history-inspected",
        ),
    )
    parser.add_argument(
        "--reason", choices=("no_meaningful_work", "user_requested_no_capture")
    )
    args, extra = parser.parse_known_args()
    with ExitStack() as locks:
        return dispatch_command(args, extra, locks)


def status_result(state, owner):
    result = json.loads(encode(state)) if state else {"status": "session_unavailable"}
    result.pop("session_request", None)
    for pending in result.get("commits", {}).values():
        pending.pop("request", None)
        pending.pop("native_arguments", None)
    result["gate"] = owner
    return result


def dispatch_command(args, extra, locks):
    if args.commit_routes is not None and (
        args.operation != "attach" or args.host != "claude-plugin"
    ):
        raise NativeError("COMMIT_ROUTES_HOST_UNSUPPORTED")
    if extra and args.operation not in ("run", "capabilities", "attach", "create"):
        raise NativeError("ARGUMENTS_INVALID")
    if args.operation == "capabilities":
        if extra or not args.release_sha256 or args.home or args.host:
            raise NativeError("CAPABILITIES_ARGUMENTS_INVALID")
        result = capabilities(args.release_sha256)
    elif args.operation in ("create", "attach"):
        if (
            extra
            or not all((args.home, args.folder, args.release_sha256))
            or (args.scope == "project" and not args.project)
        ):
            raise NativeError("CREATE_ARGUMENTS_REQUIRED")
        if args.operation == "create":
            if args.host not in (None, "codex") or args.daily_folder != "Daily":
                raise NativeError("CREATE_HOST_INVALID")
            result = create_profile(args)
        else:
            result = attach_profile(args)
    else:
        if not args.home:
            raise NativeError("HOME_REQUIRED")
        inspection = args.operation in (
            "profile-status",
            "drain-status",
            "status",
            "request",
        )
        home, profile = load_profile(args.home, inspect=inspection)
        if "parentHome" in profile and args.operation != "profile-status":
            home, profile = load_profile(
                profile["parentHome"], parent_only=True, inspect=inspection
            )
        scope = capture_scope(profile)
        if scope == "user" and args.operation not in (
            "profile-status",
            "drain-status",
            "hook",
        ):
            locks.enter_context(gate_lock(home, nonblocking=True))
            if inspection and unpublished_user_state(home):
                raise NativeError("PUBLICATION_PENDING")
            if inspection and (home / "retention-journal.json").exists():
                raise NativeError("RETENTION_JOURNAL_PENDING")
            if not inspection:
                reconcile_retention(home)
                reconcile_enrollment(home, profile)
            record, _ = read_binding(home, args.session, restore=not inspection)
            if record is None:
                raise NativeError("SESSION_BINDING_REQUIRED")
            index = archive_index(home, args.session)
            child, descriptor = bound_child(home, profile, record, inspect=inspection)
            if not inspection and any(
                p.name.startswith(".capture-")
                for p in streamed_entries(checked_state_directory(child))
            ):
                raise NativeError("PUBLICATION_AMBIGUOUS")
            if inspection and index is not None and index["location"] == "archive":
                if project_mode(descriptor) == "directory" and (
                    args.commit is not None or args.snapshot is not None
                ):
                    raise NativeError("DIRECTORY_SESSION_ONLY")
                state = archived_record(home, args.session, index)["state"]
                result = (
                    (state or {}).get(
                        "session_request", {"status": "request_unavailable"}
                    )
                    if args.operation == "request"
                    else status_result(state, None)
                )
                print(json.dumps(result))
                return 0
            home, profile = child, descriptor
        mode = project_mode(profile)
        if mode == "directory" and (
            args.operation
            in ("execute-commit", "prepare", "takeover", "resolve-snapshot")
            or args.commit is not None
            or args.snapshot is not None
        ):
            raise NativeError("DIRECTORY_SESSION_ONLY")
        if extra and args.operation != "run":
            raise NativeError("ARGUMENTS_INVALID")
        if args.operation == "profile-status":
            result = dict(
                status="validated",
                apiVersion=1,
                host=profile["host"],
                home=str(home),
                scope=capture_scope(profile),
                folder=profile["folder"],
                daily_folder=profile.get("dailyFolder", "Daily"),
                release_id=profile["releaseId"],
                release_sha256=profile["releaseSha256"],
                bundle=profile["bundle"],
                active=True,
                ownership_managed=False,
            )
            if scope == "project":
                result.update(project=profile["project"], projectMode=mode)
        elif args.operation == "drain-status":
            result = (
                user_drain_status(home, profile)
                if scope == "user"
                else drain_status(home)
            )
        elif args.operation == "execute-commit":
            return execute_commit(home, profile, args, locks)
        elif args.operation == "hook":
            result = hook(home, profile, input_json())
        elif args.operation in ("prepare", "retry"):
            result = (
                prepare_commit(home, profile, args)
                if args.operation == "prepare"
                else review_retry(home, profile, args)
            )
        elif args.operation == "skip":
            with state_lock(home, args.session) as (state, path):
                if state is None or state["turn"] != args.turn or args.reason is None:
                    raise NativeError("TURN_OR_REASON_INVALID")
                if state["disposition"] == "saved":
                    raise NativeError("SESSION_ALREADY_SAVED")
                if state.get("session_request") or state.get("session_recovery"):
                    raise NativeError("ATTEMPTED_WRITE_CANNOT_BE_POLICY_SKIPPED")
                state.update(disposition="skipped_by_policy", skip_reason=args.reason)
                atomic_write(path, encode(state))
                result = {"status": "skipped_by_policy"}
        elif args.operation == "takeover":
            result = takeover(home, profile, args)
        elif args.operation == "resolve-snapshot":
            if args.verification != "command-stopped-and-history-inspected":
                raise NativeError("TOOL_COMPLETION_VERIFICATION_REQUIRED")
            note = ""
            with state_lock(home, args.session) as (state, path):
                if not state or args.snapshot not in state["snapshots"]:
                    raise NativeError("SNAPSHOT_UNAVAILABLE")
                history = state.setdefault("snapshot_resolutions", [])
                if len(history) >= MAX_PENDING:
                    raise NativeError("SNAPSHOT_RESOLUTION_LIMIT")
                snapshot = state["snapshots"].pop(args.snapshot)
                history.append(
                    dict(
                        snapshot=args.snapshot,
                        before=snapshot,
                        observed_head=git(
                            Path(profile["project"]),
                            "rev-parse",
                            "--verify",
                            "HEAD",
                            allow_failure=True,
                        ).strip()
                        or None,
                        verification=args.verification,
                        status="not_captured",
                    )
                )
                atomic_write(path, encode(state))
                note = settle_gate(home, args.session, state)
            result = {"status": "not_captured", "snapshot": args.snapshot}
            if note:
                result["note"] = note.lstrip("\n")
        elif args.operation in ("status", "request"):
            with state_lock(home, args.session) as (state, _path):
                if args.operation == "request":
                    result = (state or {}).get(
                        "session_request", {"status": "request_unavailable"}
                    )
                else:
                    result = status_result(state, active_request(home))
        elif args.operation == "disable":
            if profile["host"] == "claude-plugin":
                raise NativeError("PLUGIN_OWNERSHIP_MANAGED_EXTERNALLY")
            with gate_lock(home):
                profile["active"] = False
                atomic_write(home / "capture-profile.json", encode(profile))
                release_gate(home / "capture-state")
            for name in OWNED:
                (home / name).unlink()
            result = {"status": "disabled", "scope": "isolated-profile"}
        else:
            if profile["host"] != "codex":
                raise NativeError("RUN_HOST_UNSUPPORTED")
            if any(
                x
                in (
                    "-C",
                    "--cd",
                    "-c",
                    "--config",
                    "-p",
                    "--profile",
                    "--enable",
                    "--disable",
                )
                or x.startswith(
                    (
                        "-C",
                        "-c",
                        "-p",
                        "--cd=",
                        "--config=",
                        "--profile=",
                        "--enable=",
                        "--disable=",
                    )
                )
                for x in extra
            ):
                raise NativeError("PROFILE_OVERRIDE_REFUSED")
            os.chdir(profile["project"])
            runtime_home = home / "runtime-home"
            if runtime_home.is_symlink() or not runtime_home.is_dir():
                raise NativeError("RUNTIME_HOME_INVALID")
            environment = dict(os.environ, CODEX_HOME=str(home), HOME=str(runtime_home))
            environment.update(
                {
                    "XDG_" + kind + "_HOME": str(runtime_home / relative)
                    for kind, relative in (
                        ("CONFIG", ".config"),
                        ("DATA", ".local/share"),
                        ("STATE", ".local/state"),
                        ("CACHE", ".cache"),
                    )
                }
            )
            os.execvpe("codex", ["codex", *extra], environment)
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except NativeError as error:
        print("obsidian-mcp-native: " + str(error), file=sys.stderr)
        raise SystemExit(64)
    except (
        OSError,
        RuntimeError,
        ValueError,
        KeyError,
        TypeError,
        subprocess.SubprocessError,
    ):
        print(
            "obsidian-mcp-native: operation refused or capture unresolved; inspect profile, event and recovery state",
            file=sys.stderr,
        )
        raise SystemExit(64)
